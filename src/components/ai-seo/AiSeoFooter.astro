---
import { AI_SEO_CAL_LINK, AI_SEO_PATH, caseStudyPath, featuredCaseStudy } from '~/data/ai-seo';
export interface Props {
  servicesHref?: string;
  showCase?: boolean;
  label?: string;
  callLabel?: string;
  /** Where the wordmark links. Subsites that should not send visitors to the main site set their own path. */
  homeHref?: string;
}

const {
  servicesHref = `${AI_SEO_PATH}#services`,
  showCase = true,
  label = 'AI SEO footer',
  callLabel = 'Book a discovery call',
  homeHref = '/',
} = Astro.props;
---

<footer class="ais ais-footer">
  <div class="ais-wrap ais-footer__row">
    <a class="ais-wordmark" href={homeHref}>SellOn<span>Tube</span></a>
    <nav aria-label={label}>
      <a href={servicesHref}>Services</a>
      {showCase && featuredCaseStudy && <a href={caseStudyPath(featuredCaseStudy.slug)}>{featuredCaseStudy.client} case study</a>}
      <a href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="footer">{callLabel}</a
      >
      <a href="/privacy-policy">Privacy</a>
      <a href="/terms-of-service">Terms</a>
    </nav>
  </div>
  <div class="ais-wrap ais-footer__meta">
    <p>
      <a href="mailto:hello@sellontube.com">hello@sellontube.com</a>
      <span>&copy; {new Date().getFullYear()} SellOnTube</span>
    </p>
  </div>
</footer>
