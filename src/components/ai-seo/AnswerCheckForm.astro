---
// The free AI answer check. Posts to the existing capture-email function, which writes to
// the leads sheet. The follow-up is manual, and this source joins no email sequence.
---

<form class="ais-check" data-ais-check data-astro-reload novalidate>
  <div class="ais-check__fields">
    <div>
      <label for="ais-check-email">Work email</label>
      <input
        id="ais-check-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@company.com"
        required
      />
    </div>
    <div>
      <label for="ais-check-url">Product website</label>
      <input
        id="ais-check-url"
        name="productUrl"
        type="url"
        inputmode="url"
        autocomplete="url"
        placeholder="https://yourproduct.com"
        required
      />
    </div>
  </div>
  <p class="ais-check__status" role="status" aria-live="polite" data-ais-check-status></p>
  <button class="ais-btn" type="submit">Get a free ChatGPT check</button>
  <p class="ais-note" style="margin: 0.75rem 0 0">
    We use your email to send this check and follow up about it. See our <a href="/privacy-policy">privacy policy</a>.
  </p>
</form>

<script>
  // Delegated, so it survives ClientRouter page swaps.
  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches('[data-ais-check]')) return;
    event.preventDefault();

    const status = form.querySelector<HTMLElement>('[data-ais-check-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();
    let productUrl = String(data.get('productUrl') || '').trim();
    if (productUrl && !/^https?:\/\//i.test(productUrl)) productUrl = `https://${productUrl}`;

    const show = (message: string) => {
      if (status) status.textContent = message;
    };
    const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');
    const urlInput = form.querySelector<HTMLInputElement>('[name="productUrl"]');
    emailInput?.removeAttribute('aria-invalid');
    urlInput?.removeAttribute('aria-invalid');
    const reject = (input: HTMLInputElement | null, message: string) => {
      input?.setAttribute('aria-invalid', 'true');
      input?.focus();
      show(message);
    };

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return reject(emailInput, 'Please enter a valid email address.');
    if (!productUrl.includes('.')) return reject(urlInput, 'Please enter your product website.');

    if (button) button.disabled = true;
    show('Sending...');

    try {
      const response = await fetch('/.netlify/functions/capture-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, productUrl, source: 'ai-seo-answer-check' }),
      });
      if (!response.ok) throw new Error(`Status ${response.status}`);

      form.reset();
      show('Thanks. We will email you what ChatGPT says about your product.');
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'ai_seo_check_submit', { page_path: window.location.pathname });
      }
    } catch {
      show('That did not send. Please try again, or email hello@sellontube.com.');
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
