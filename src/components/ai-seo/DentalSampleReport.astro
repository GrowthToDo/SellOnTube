---
// A sample report layout with made-up numbers. It shows the shape of the monthly report,
// never a client result. The "Sample" tag and the note under the table say so.
export interface Props {
  title: string;
  columns: string[];
  rows: { channel: string; calls: number; forms: number; booked: number }[];
  totalLabel: string;
  note: string;
}

const { title, columns, rows, totalLabel, note } = Astro.props;
const total = rows.reduce(
  (sum, row) => ({
    calls: sum.calls + row.calls,
    forms: sum.forms + row.forms,
    booked: sum.booked + row.booked,
  }),
  { calls: 0, forms: 0, booked: 0 }
);
---

<figure class="dsr">
  <div class="dsr__head">
    <p class="ais-bars__title">{title}</p>
    <span class="dsr__tag">Sample</span>
  </div>
  <table>
    <caption class="dsr__sr">{title}: calls, forms and booked consultations by channel, with made-up numbers</caption>
    <thead>
      <tr>
        {columns.map((column, i) => <th scope="col" class:list={{ 'is-num': i > 0 }}>{column}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.channel}</th>
            <td class="is-num">{row.calls}</td>
            <td class="is-num">{row.forms}</td>
            <td class="is-num is-key">{row.booked}</td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr>
        <th scope="row">{totalLabel}</th>
        <td class="is-num">{total.calls}</td>
        <td class="is-num">{total.forms}</td>
        <td class="is-num is-key">{total.booked}</td>
      </tr>
    </tfoot>
  </table>
  <figcaption class="ais-note">{note}</figcaption>
</figure>

<style>
  .dsr {
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--white);
  }
  .dsr__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .dsr__tag {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--ink-2);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .dsr__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .dsr table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .dsr th,
  .dsr td {
    padding: 0.5rem 0.25rem;
    border-top: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
  }
  .dsr thead th {
    border-top: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .dsr .is-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .dsr .is-key {
    font-weight: 700;
  }
  .dsr tfoot th,
  .dsr tfoot td {
    border-top: 2px solid var(--ink-2);
    font-weight: 700;
  }
  .dsr figcaption {
    margin-top: 0.75rem;
  }
</style>
