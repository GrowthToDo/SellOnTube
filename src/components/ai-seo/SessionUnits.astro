---
// Unit chart: one square per ChatGPT session. Filled squares equal the install-event count.
// The counts are printed beside the squares, so colour is never the only carrier.
export interface Props {
  sessions: number;
  installEvents: number;
}

const { sessions, installEvents } = Astro.props;
---

<figure class="ais-units">
  <div class="ais-units__legend" aria-hidden="true">
    <span><i class="ais-unit ais-unit--on"></i>Filled: install-event count</span>
    <span><i class="ais-unit"></i>Every square: one session</span>
  </div>
  <div role="img" aria-label={`Chart of ${sessions} ChatGPT sessions and ${installEvents} install events.`}>
    <div class="ais-units__row">
      <span class="ais-units__label">{installEvents} of {sessions}</span>
      <span class="ais-units__cells">
        {
          Array.from({ length: sessions }, (_, i) => (
            <i class:list={['ais-unit', { 'ais-unit--on': i < installEvents }]} />
          ))
        }
      </span>
    </div>
  </div>
  <figcaption class="ais-note" style="margin-top: 0.75rem">
    Filled squares show the count of install events. GA4 does not match each event to a specific session.
  </figcaption>
</figure>
