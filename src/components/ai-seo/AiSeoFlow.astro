---
import type { FlowStep } from '~/data/ai-seo';

export interface Props {
  steps: FlowStep[];
}

const { steps } = Astro.props;
---

<ol class="ais-flow" aria-label="How a buyer moves from an AI question to becoming a customer">
  {
    steps.map((step) => (
      <li>
        <span class="ais-label">{step.label}</span>
        <span class="ais-flow__text">{step.text}</span>
      </li>
    ))
  }
</ol>
