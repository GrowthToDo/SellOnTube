---
// A sample audit summary with made-up findings. It shows what the free audit looks like,
// never a real practice. The "Sample" tag and the note under the card say so.
export interface Props {
  title: string;
  practice: string;
  findings: { priority: string; text: string }[];
  note: string;
}

const { title, practice, findings, note } = Astro.props;
---

<figure class="das">
  <div class="das__head">
    <div>
      <p class="das__title">{title}</p>
      <p class="das__practice">{practice}</p>
    </div>
    <span class="das__tag">Sample</span>
  </div>
  <ol class="das__list">
    {
      findings.map((finding) => (
        <li>
          <span class:list={['das__priority', `is-${finding.priority.toLowerCase()}`]}>{finding.priority}</span>
          <span>{finding.text}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="das__note">{note}</figcaption>
</figure>

<style>
  .das {
    margin: 0;
    padding: 1.25rem;
    border-top: 4px solid var(--accent);
    border-radius: 4px;
    background: var(--white);
    color: var(--ink);
  }
  .das__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .das__title {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.25;
  }
  .das__practice {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .das__tag {
    flex: none;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--ink-2);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .das__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .das__list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.625rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .das__priority {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .das__priority.is-high {
    color: var(--accent);
  }
  .das__note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
</style>
