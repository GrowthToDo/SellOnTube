---
// Two lists side by side: the usual way against ours, or a good fit against a poor one.
export interface Props {
  leftTitle: string;
  left: string[];
  rightTitle: string;
  right: string[];
  /** contrast: the right list is the one we back. fit: the left list is. */
  mode?: 'contrast' | 'fit';
}

const { leftTitle, left, rightTitle, right, mode = 'contrast' } = Astro.props;
const lists = [
  { title: leftTitle, items: left, on: mode === 'fit' },
  { title: rightTitle, items: right, on: mode !== 'fit' },
];
---

<div class="dcmp">
  {
    lists.map((list) => (
      <div class:list={['dcmp__col', { 'is-on': list.on }]}>
        <h3 class="ais-h4">{list.title}</h3>
        <ul>
          {list.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .dcmp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .dcmp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .dcmp__col {
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-top: 4px solid #b3a998;
    border-radius: 4px;
    background: var(--white);
  }
  .dcmp__col.is-on {
    border-top-color: var(--accent);
  }
  .dcmp ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .dcmp li {
    padding-block: 0.375rem;
    border-top: 1px solid var(--rule);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .dcmp li:first-child {
    border-top: 0;
  }
</style>
