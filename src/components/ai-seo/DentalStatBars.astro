---
// Survey shares drawn on a true 0 to 100% scale. No min-width on a bar, so the drawn
// ratio always matches the number. Each row names its own source.
import type { DentalStat } from '~/data/ai-seo-dental';

export interface Props {
  title: string;
  stats: DentalStat[];
  note: string;
}

const { title, stats, note } = Astro.props;
---

<figure class="dsb">
  <p class="ais-bars__title">{title}</p>
  <ul>
    {
      stats.map((stat) => (
        <li>
          <span class="dsb__label">{stat.label}</span>
          <span class="dsb__row">
            <span class="dsb__track" aria-hidden="true">
              <span class:list={['dsb__bar', { 'is-on': stat.highlight }]} style={`width: ${stat.rate}%`} />
            </span>
            <span class="dsb__value">{stat.rate}%</span>
          </span>
          <span class="dsb__source">{stat.source}</span>
        </li>
      ))
    }
  </ul>
  <figcaption class="ais-note">{note}</figcaption>
</figure>

<style>
  .dsb {
    margin: 0;
  }
  .dsb ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dsb li {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.75rem;
  }
  .dsb__label {
    font-size: 1rem;
    line-height: 1.35;
  }
  .dsb__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 0.5rem;
  }
  .dsb__track {
    display: block;
    height: 1.25rem;
  }
  .dsb__bar {
    display: block;
    height: 100%;
    border-radius: 0 3px 3px 0;
    background: #b3a998;
  }
  .dsb__bar.is-on {
    background: var(--accent);
  }
  .dsb__value {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .dsb__source {
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .dsb figcaption {
    margin-top: 0.5rem;
  }
</style>
