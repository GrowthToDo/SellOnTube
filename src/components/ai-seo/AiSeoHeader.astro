---
import { AI_SEO_CAL_LINK, AI_SEO_PATH, caseStudyPath, featuredCaseStudy } from '~/data/ai-seo';

export interface Props {
  /** Page the wordmark and anchors point at. Defaults to the AI SEO landing page. */
  base?: string;
  servicesId?: string;
  checkId?: string;
  checkLabel?: string;
  label?: string;
  showCase?: boolean;
  /** A short line under the wordmark, e.g. the offer this subsite sells. */
  subline?: string;
}

const {
  base = AI_SEO_PATH,
  servicesId = 'services',
  checkId = 'check',
  checkLabel = 'Free check',
  label = 'SellOnTube AI SEO services',
  showCase = true,
  subline,
} = Astro.props;

const servicesHref = `${base}#${servicesId}`;
---

<a class="ais ais-skip" href="#ais-main">Skip to content</a>
<header class="ais ais-header">
  <div class="ais-wrap ais-header__row">
    <a class="ais-wordmark" href={base} aria-label={label}
      >SellOn<span>Tube</span>{subline && <small class="ais-wordmark__sub">{subline}</small>}</a
    >
    <nav class="ais-nav" aria-label={label}>
      <a class="ais-nav__services" href={servicesHref}>Services</a>
      <a class="ais-nav__check" href={`${base}#${checkId}`}>{checkLabel}</a>
      {
        showCase && featuredCaseStudy && (
          <a class="ais-nav__case" href={caseStudyPath(featuredCaseStudy.slug)} data-ais-case="header">
            Case study
          </a>
        )
      }
      <a
        class="ais-btn ais-btn--sm ais-header__cta"
        href={AI_SEO_CAL_LINK}
        target="_blank"
        rel="noopener noreferrer"
        data-ais-cta="header"
      >
        Book a call
      </a>
    </nav>
  </div>
</header>

<style>
  .ais-wordmark__sub {
    display: block;
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--rule);
    font-family: var(--body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--ink-2);
  }
  /* Phones: the header row has no room, and the hero eyebrow says the same thing. */
  @media (max-width: 559px) {
    .ais-wordmark__sub {
      display: none;
    }
  }
</style>
