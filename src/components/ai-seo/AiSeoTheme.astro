---
// Design language for the /ai-seo subsite. Import once per page, inside Layout.
// Colours are fixed on purpose: the subsite does not follow the site's dark mode toggle.
---

<style is:global>
  html,
  body {
    background: #fbf8f2 !important;
  }

  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Medium.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Black.woff2') format('woff2');
    font-weight: 900;
    font-display: swap;
    font-style: normal;
  }

  .ais {
    --paper: #fbf8f2;
    --tint: #f1e9db;
    --white: #ffffff;
    --ink: #17140f;
    --ink-2: #4a453c;
    --ink-3: #6a6458;
    --rule: #d9d2c5;
    --accent: #b93a22;
    --accent-ink: #9f2f1a;
    --accent-bright: #f0694d;
    --on-accent: #fffaf6;
    --band: #17140f;
    --on-band: #fbf8f2;
    --on-band-2: #cfc9bd;
    --off-cell: #4c463b;
    --display: 'Satoshi', 'Inter Variable', system-ui, sans-serif;
    --body: 'Inter Variable', system-ui, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.6;
    letter-spacing: -0.005em;
    overflow-wrap: break-word;
  }

  .ais *:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .ais-band *:focus-visible {
    outline-color: var(--on-band);
  }

  .ais-wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    .ais-wrap {
      padding-inline: 2.5rem;
    }
  }

  .ais-skip {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
  }
  .ais-skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  /* Header: stays in view, so a button is always one tap away. */
  .ais-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--rule);
  }
  .ais-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.5rem;
  }
  .ais-wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .ais-wordmark span {
    color: var(--accent-ink);
  }
  .ais-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .ais-nav a:not(.ais-btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .ais-nav a:not(.ais-btn):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 639px) {
    .ais-nav__services,
    .ais-nav__check {
      display: none !important;
    }
    .ais-nav {
      gap: 0.75rem;
    }
  }
  @media (max-width: 359px) {
    .ais-nav__case {
      display: none !important;
    }
  }

  /* Buttons and links */
  .ais-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: 2px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 3px;
  }
  .ais-btn:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }
  .ais-btn--sm {
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .ais .ais-btn--band-ghost {
    background: transparent;
    color: var(--on-band);
    border-color: var(--on-band);
  }
  .ais .ais-btn--band-ghost:hover {
    background: var(--on-band);
    border-color: var(--on-band);
    color: var(--ink);
  }
  .ais-link {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ais-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* Type */
  .ais-eyebrow,
  .ais-label {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .ais-eyebrow {
    margin: 0 0 0.875rem;
  }
  .ais-label {
    display: block;
    margin: 0 0 0.25rem;
  }
  .ais-band .ais-eyebrow {
    color: var(--accent-bright);
  }
  .ais-h1 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .ais-h1--study {
    font-size: clamp(2.375rem, 6.5vw, 4.25rem);
    line-height: 1.02;
    max-width: 20ch;
  }
  .ais-h2 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
    max-width: 28ch;
    text-wrap: balance;
  }
  .ais-h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }
  .ais-h4 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.25;
    margin: 0 0 0.625rem;
  }
  .ais-lede {
    font-size: clamp(1.125rem, 2.2vw, 1.3125rem);
    line-height: 1.45;
    max-width: 38rem;
    margin: 1rem 0 0;
  }
  .ais-deliver {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--on-band-2);
  }
  .ais-section .ais-h2 + .ais-lede {
    margin-top: 0;
  }
  .ais-prose {
    max-width: 40rem;
  }
  .ais-prose p {
    margin: 0 0 0.875rem;
  }
  .ais-prose p:last-child {
    margin-bottom: 0;
  }
  .ais-note {
    text-wrap: pretty;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 42rem;
    margin: 0.75rem 0 0;
  }

  /* Sections */
  .ais-section {
    padding-block: 3rem;
    scroll-margin-top: 4.25rem;
  }
  .ais-section--tint {
    background: var(--tint);
  }
  .ais-section--white {
    background: var(--white);
  }
  .ais .ais-section--method {
    padding-block: 1.25rem 0;
  }
  .ais-hero {
    padding-block: 2.25rem 2.75rem;
  }
  @media (min-width: 768px) {
    .ais-section {
      padding-block: 5rem;
    }
    .ais-hero {
      padding-block: 4.5rem;
    }
  }
  .ais-band {
    background: var(--band);
    color: var(--on-band);
  }
  .ais-band .ais-note {
    color: var(--on-band-2);
  }
  .ais-band--rust {
    background: var(--accent);
    color: var(--on-accent);
  }
  .ais-band--rust .ais-note {
    color: var(--on-accent);
  }
  .ais-band--rust .ais-btn {
    background: var(--on-accent);
    border-color: var(--on-accent);
    color: var(--ink);
  }
  .ais-band--rust .ais-btn:hover {
    background: var(--tint);
    border-color: var(--tint);
  }
  .ais-two {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .ais-two {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .ais-sub {
    margin-top: 2.5rem;
  }

  /* Hero */
  .ais-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .ais-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
    }
  }
  .ais-hero__opening {
    margin-top: 1.25rem;
    font-size: 1.125rem;
  }
  .ais-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.875rem;
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    border-radius: 3px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1;
  }
  .ais-logo img {
    display: block;
    width: 1.75rem;
    height: auto;
  }

  /* Proof grid */
  .ais-proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .ais-proof {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }
  .ais-grid-panel {
    margin: 0;
    padding: 1.5rem 1.25rem;
    border-radius: 4px;
    background: var(--band);
    color: var(--on-band);
  }
  .ais-grid-panel__rate {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(3.75rem, 16vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .ais-grid-panel__label {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.25;
    color: var(--accent-bright);
  }
  .ais-grid-panel__line {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.25;
  }
  .ais-grid-panel__cells {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 3px;
    margin-top: 1.25rem;
  }
  .ais-grid-panel__cells i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--off-cell);
  }
  .ais-grid-panel__cells i.is-on {
    background: var(--accent-bright);
  }
  .ais-grid-panel figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--on-band-2);
  }

  /* Question map */
  .ais-qmap {
    margin: 2.5rem 0 0;
    max-width: 44rem;
  }
  .ais-qmap__title,
  .ais-range__title,
  .ais-bars__title {
    margin: 0 0 0.75rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.25;
  }
  .ais-qmap__cells {
    display: grid;
    grid-template-columns: repeat(15, minmax(0, 1fr));
    gap: 3px;
  }
  .ais-qmap__cells i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--rule);
  }
  .ais-qmap__cells i.is-on {
    background: var(--accent);
  }

  /* Range plot */
  .ais-range {
    margin: 1.75rem 0 0;
  }
  .ais-range__axis {
    position: relative;
    height: 3rem;
    border-bottom: 2px solid var(--ink);
  }
  .ais-range__span {
    position: absolute;
    bottom: -5px;
    height: 8px;
    border-radius: 4px;
    background: #b3a998;
  }
  .ais-range__dot {
    position: absolute;
    bottom: -8px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--paper);
  }
  .ais-range__label {
    position: absolute;
    bottom: 0.625rem;
    transform: translateX(-50%);
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.125rem;
  }
  .ais-range__ticks {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  /* Source bars */
  .ais-bars {
    margin: 0;
  }
  .ais-bars ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ais-bars li {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr) 3.25rem;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.3125rem;
    font-size: 0.9375rem;
  }
  .ais-bars__track {
    display: block;
  }
  .ais-bars__bar {
    display: block;
    height: 1.25rem;
    border-radius: 0 3px 3px 0;
    background: #b3a998;
  }
  .ais-bars__bar.is-on {
    background: var(--accent);
  }
  .ais-bars__value {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Buyer path */
  .ais-flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .ais-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ais-flow li {
    padding: 0.875rem;
    border-radius: 4px;
    background: var(--tint);
  }
  .ais-flow__text {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .ais-flow li.is-typical {
    background: transparent;
    border: 1px dashed var(--ink-3);
  }
  .ais-flow__tag {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ais-flow__note {
    margin-top: 0.75rem;
  }

  /* Service tiles */
  .ais-tiles__title {
    margin-top: 3.5rem;
  }
  .ais-tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .ais-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ais-tile {
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--accent);
    border-radius: 4px;
    background: var(--white);
  }
  .ais-tile p {
    margin: 0 0 0.625rem;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.5;
  }
  .ais-tile p:last-child {
    margin-bottom: 0;
  }
  .ais-optional {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }

  /* Measurement ladder */
  .ais-ladder {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .ais-ladder li {
    padding: 0.75rem 1rem;
    margin-bottom: 4px;
    border-radius: 3px;
    color: var(--on-accent);
    line-height: 1.3;
  }
  .ais-ladder strong,
  .ais-ladder span {
    display: block;
  }
  .ais-ladder strong {
    font-family: var(--display);
    font-weight: 700;
  }
  .ais-ladder span {
    font-size: 0.9375rem;
  }
  .ais-ladder li:nth-child(1) {
    background: var(--accent);
  }
  .ais-ladder li:nth-child(2) {
    background: #55493a;
  }
  .ais-ladder li:nth-child(3) {
    background: #55493a;
  }

  /* Rail: steps and dated work */
  .ais-rail {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--ink);
  }
  .ais-rail li {
    position: relative;
    padding-bottom: 1.125rem;
    line-height: 1.4;
  }
  .ais-rail li:last-child {
    padding-bottom: 0;
  }
  .ais-rail li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 7px);
    top: 0.3125rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
  }
  .ais-rail li.is-on::before {
    background: var(--accent);
  }
  .ais-rail strong,
  .ais-rail span {
    display: block;
  }
  .ais-rail strong {
    font-family: var(--display);
    font-weight: 700;
  }
  .ais-rail span {
    color: var(--ink-2);
    font-size: 1rem;
  }

  /* FAQ: all answers stay visible, because ai-seo-guide.md treats visible FAQ text as a citation signal. */
  .ais-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 3rem;
  }
  @media (min-width: 768px) {
    .ais-faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ais-faq__item p {
    margin: 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.5;
  }
  .ais-faq .ais-h3 {
    margin-bottom: 0.375rem;
    font-size: 1.25rem;
  }

  /* Founders */
  .ais-team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  @media (min-width: 900px) {
    .ais-team {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 3.5rem;
      align-items: center;
    }
  }
  .ais-team img,
  .ais-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .ais-shot {
    margin: 1.75rem 0 0;
  }
  .ais-faces {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.75rem;
  }
  .ais-faces p {
    margin: 0;
    font-weight: 600;
  }
  .ais-faces__row {
    display: flex;
    flex: none;
  }
  .ais-faces__row img {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--band);
  }
  .ais-faces__row img + img {
    margin-left: -0.625rem;
  }

  /* Free check form */
  .ais-check__fields {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .ais-check label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }
  .ais-check input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--on-band-2);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .ais-check input::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }
  .ais-check input[aria-invalid='true'] {
    border: 2px solid var(--ink);
    background: var(--white);
  }
  .ais-check .ais-btn {
    width: 100%;
    min-height: 3rem;
  }
  .ais-check__status {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }
  .ais-check__status:empty {
    display: none;
  }
  .ais-check .ais-note {
    margin-top: 0.75rem;
  }
  .ais-band .ais-note a {
    color: inherit;
  }

  /* Case study hero */
  .ais-crumbs {
    font-size: 0.875rem;
    color: var(--on-band-2);
    margin: -0.75rem 0 0.5rem;
  }
  .ais-crumbs a {
    display: inline-block;
    padding-block: 0.625rem;
    color: inherit;
  }
  .ais-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 40rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
