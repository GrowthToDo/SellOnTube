---
// Design language for the /ai-seo subsite. Import once per page, inside Layout.
// Colours are fixed on purpose: the subsite does not follow the site's dark mode toggle.
---

<style is:global>
  html,
  body {
    background: #fbf8f2 !important;
  }

  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Medium.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/satoshi/Satoshi-Black.woff2') format('woff2');
    font-weight: 900;
    font-display: swap;
    font-style: normal;
  }

  .ais {
    --paper: #fbf8f2;
    --ink: #17140f;
    --ink-2: #4a453c;
    --ink-3: #6a6458;
    --rule: #d9d2c5;
    --mark-off: #857e72;
    --accent: #b93a22;
    --accent-ink: #9f2f1a;
    --on-accent: #fffaf6;
    --band: #17140f;
    --on-band: #fbf8f2;
    --on-band-2: #cfc9bd;
    --display: 'Satoshi', 'Inter Variable', system-ui, sans-serif;
    --body: 'Inter Variable', system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.6;
    letter-spacing: -0.005em;
    overflow-wrap: break-word;
  }

  .ais *:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .ais-band *:focus-visible {
    outline-color: var(--on-band);
  }

  .ais-wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    .ais-wrap {
      padding-inline: 2.5rem;
    }
  }

  .ais-skip {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
  }
  .ais-skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  /* Header */
  .ais-header {
    border-bottom: 1px solid var(--rule);
  }
  .ais-header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.875rem;
  }
  .ais-wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .ais-wordmark span {
    color: var(--accent-ink);
  }
  .ais-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .ais-nav a:not(.ais-btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .ais-nav a:not(.ais-btn):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 479px) {
    .ais-nav .ais-header__cta {
      display: none;
    }
    .ais .ais-hero {
      padding-block: 2rem 3rem;
    }
  }

  /* Buttons and links */
  .ais-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    border: 2px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 3px;
  }
  .ais-btn:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }
  .ais-btn--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .ais-btn--ghost:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .ais-btn--sm {
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
  }
  .ais-link {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ais-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Type */
  .ais-eyebrow {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--accent-ink);
    margin: 0 0 1.25rem;
  }
  .ais-h1 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.75rem, 9.5vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 14ch;
    text-wrap: balance;
  }
  .ais-h1--study {
    font-size: clamp(2.25rem, 6.5vw, 4.5rem);
    line-height: 1.03;
    max-width: 20ch;
  }
  .ais-h2 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.875rem, 4.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
    max-width: 22ch;
    text-wrap: balance;
  }
  .ais-h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }
  .ais-lede {
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 38rem;
    margin: 0;
  }
  .ais-prose {
    max-width: 42rem;
  }
  .ais-prose p {
    margin: 0 0 1rem;
  }
  .ais-prose p:last-child {
    margin-bottom: 0;
  }
  .ais-note {
    text-wrap: pretty;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 42rem;
  }

  /* Sections */
  .ais-section {
    padding-block: 3.5rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }
  .ais-hero {
    padding-block: 3.5rem 3rem;
  }
  @media (min-width: 768px) {
    .ais-section {
      padding-block: 5.5rem;
    }
    .ais-hero {
      padding-block: 4rem 3.5rem;
    }
  }
  .ais-band {
    background: var(--band);
    color: var(--on-band);
  }
  .ais-band .ais-note {
    color: var(--on-band-2);
  }
  .ais-band .ais-btn {
    background: var(--on-band);
    border-color: var(--on-band);
    color: var(--ink);
  }
  .ais-band .ais-btn:hover {
    background: var(--on-band-2);
    border-color: var(--on-band-2);
  }

  /* Evidence */
  .ais-proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .ais-proof {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }
  .ais-proof__client {
    font-family: var(--display);
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .ais-proof__numbers {
    display: flex;
    align-items: baseline;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(4.5rem, 15vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ais-proof__of {
    color: var(--ink-3);
    font-weight: 500;
  }
  .ais-proof__line {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    line-height: 1.2;
    margin: 1rem 0 0.75rem;
    max-width: 24ch;
  }
  .ais-units {
    margin: 0;
  }
  .ais-units__row {
    padding-block: 0.875rem;
    border-top: 1px solid var(--rule);
  }
  .ais-units__label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }
  .ais-units__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ais-unit {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1.5px solid var(--mark-off);
    background: transparent;
  }
  .ais-unit--on {
    background: var(--accent);
    border-color: var(--accent);
  }
  .ais-units__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-bottom: 0.875rem;
  }
  .ais-units__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Ruled lists */
  .ais-rows {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .ais-rows > li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 768px) {
    .ais-rows > li {
      grid-template-columns: 3rem minmax(0, 20rem) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  .ais-rows__n {
    font-family: var(--display);
    font-weight: 900;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .ais-rows p {
    margin: 0;
    color: var(--ink-2);
  }
  .ais-optional {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .ais-topics {
    margin-top: 3rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .ais-topics {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .ais-questions {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .ais-questions li + li {
    margin-top: 0.5rem;
  }

  /* Tables */
  .ais-table-wrap {
    overflow-x: auto;
    margin-top: 1.5rem;
  }
  .ais-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .ais-table caption {
    text-align: left;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .ais-table th,
  .ais-table td {
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--rule);
  }
  .ais-table thead th {
    vertical-align: bottom;
    border-top: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .ais-table tbody th {
    font-weight: 600;
  }

  /* FAQ */
  .ais-faq {
    margin-top: 2.5rem;
    max-width: 48rem;
  }
  .ais-faq__item {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .ais-faq__item p {
    margin: 0;
    color: var(--ink-2);
  }

  /* Case study */
  .ais-crumbs {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0 0 2rem;
  }
  .ais-crumbs a {
    display: inline-block;
    padding-block: 0.75rem;
    color: var(--ink-2);
  }
  .ais-byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .ais-byline img {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .ais-byline p {
    margin: 0;
  }
  .ais-strip {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }
  @media (min-width: 640px) {
    .ais-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ais-strip dd {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .ais-strip dt {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .ais-sub {
    margin-top: 2.5rem;
  }
  .ais-list {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
    max-width: 44rem;
  }
  .ais-list li {
    margin-bottom: 0.75rem;
  }
  .ais-list li:last-child {
    margin-bottom: 0;
  }
  .ais-two {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .ais-two {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .ais-defs {
    margin: 1.25rem 0 0;
    max-width: 48rem;
  }
  .ais-defs dt {
    font-family: var(--display);
    font-weight: 700;
    margin-top: 1rem;
  }
  .ais-defs dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* Hero with a recorded answer */
  .ais-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .ais-hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 3.5rem;
      align-items: center;
    }
    .ais-hero__grid .ais-h1 {
      font-size: clamp(3.5rem, 5.4vw, 5.25rem);
    }
  }
  .ais-answer {
    margin: 0;
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--accent);
    border-radius: 3px;
  }
  .ais-answer__label {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .ais-answer__question {
    margin: 0 0 1rem;
    color: var(--ink-2);
    line-height: 1.4;
  }
  .ais-answer__quote {
    margin: 0;
  }
  .ais-answer__quote p {
    margin: 0 0 0.25rem;
    line-height: 1.35;
  }
  .ais-answer__quote .is-lead {
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
  }
  .ais-answer__position {
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .ais-answers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .ais-answers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Flow */
  .ais-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .ais-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .ais-flow__step {
    position: relative;
    padding: 1.25rem 0 1.25rem 3.25rem;
    border-top: 2px solid var(--ink);
  }
  @media (min-width: 768px) {
    .ais-flow__step {
      padding: 1.25rem 0 0;
    }
  }
  .ais-flow__n {
    position: absolute;
    left: 0;
    top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--display);
    font-weight: 900;
  }
  @media (min-width: 768px) {
    .ais-flow__n {
      position: static;
      margin-bottom: 0.75rem;
    }
  }
  .ais-flow__step p {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.4;
  }
  .ais-flow .ais-flow__work {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  /* Free check form */
  .ais-check__fields {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .ais-check label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }
  .ais-check input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--on-band-2);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .ais-check__status {
    min-height: 1.5rem;
    margin: 0.75rem 0 0;
    font-weight: 600;
  }
  .ais-band .ais-note a {
    color: inherit;
  }

  /* Team, listing image and timeline */
  .ais-team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .ais-team {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 3.5rem;
      align-items: center;
    }
  }
  .ais-team img,
  .ais-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .ais-shot {
    margin: 0;
  }
  .ais-shot img {
    border: 1px solid var(--rule);
  }
  .ais-shot figcaption {
    margin-top: 0.5rem;
  }
  .ais-timeline {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--accent);
    max-width: 44rem;
  }
  .ais-timeline li {
    padding-block: 0.625rem;
  }
  .ais-timeline__when {
    display: block;
    font-family: var(--display);
    font-weight: 700;
  }

  /* Growth bars */
  .ais-growth {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
    max-width: 44rem;
  }
  .ais-growth__label {
    margin: 0 0 0.375rem;
  }
  .ais-growth__bars {
    display: grid;
    gap: 3px;
  }
  .ais-growth__bar {
    display: block;
    min-width: 7rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 0 3px 3px 0;
  }
  .ais-growth__bar.is-before {
    background: var(--rule);
    color: var(--ink);
  }
  .ais-growth__bar.is-after {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ais-details {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    max-width: 48rem;
  }
  .ais-details summary {
    cursor: pointer;
    font-family: var(--display);
    font-weight: 700;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .ais-band .ais-btn--band-ghost {
    background: transparent;
    color: var(--on-band);
    border-color: var(--on-band);
  }
  .ais-band .ais-btn--band-ghost:hover {
    color: var(--ink);
  }

  /* Conversational bridges */
  .ais-bridge {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.3;
    color: var(--accent-ink);
    max-width: 40rem;
  }
  .ais-band .ais-bridge {
    color: var(--on-band-2);
  }
  .ais-subhead {
    margin: 0.875rem 0 0;
    max-width: 38rem;
    color: var(--ink-2);
  }
  .ais-strip dd.is-quote {
    font-size: clamp(1.625rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
