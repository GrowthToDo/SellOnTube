---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { SITE } from 'astrowind:config';

const siteUrl = SITE.site || 'https://sellontube.com';

const metadata = {
  title: 'Free AI YouTube Transcript Generator, No Signup | SellOnTube',
  description:
    'Free AI YouTube transcript generator. Get clean text from any video in seconds. Study competitor scripts, extract keywords, and repurpose content. No signup.',
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": `${siteUrl}/tools` },
    { "@type": "ListItem", "position": 3, "name": "YouTube Transcript Generator", "item": `${siteUrl}/tools/youtube-transcript-generator` }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SellonTube YouTube Transcript Generator",
  "url": `${siteUrl}/tools/youtube-transcript-generator`,
  "description": "Free AI YouTube transcript generator. Extract clean transcripts from any video in seconds. Study competitor scripts, analyze keyword usage, and extract content insights. No signup.",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "SellonTube", "url": siteUrl }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Is this YouTube transcript generator free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You get 3 free transcripts without signup. Enter a business email to unlock unlimited transcripts at no cost. There is no paid tier and no feature restrictions." } },
    { "@type": "Question", "name": "How accurate are the transcripts?", "acceptedAnswer": { "@type": "Answer", "text": "The tool extracts captions directly from YouTube. For videos with manual captions, accuracy is near-perfect. For auto-generated captions, accuracy depends on audio quality and speaker clarity." } },
    { "@type": "Question", "name": "Is it legal to transcribe competitor videos?", "acceptedAnswer": { "@type": "Answer", "text": "This tool extracts publicly available caption data from YouTube. Using transcripts for competitive research, content analysis, and strategy development falls under standard fair use." } },
    { "@type": "Question", "name": "What is the difference between clean text and timestamped view?", "acceptedAnswer": { "@type": "Answer", "text": "Clean text gives you the full transcript as readable prose, ideal for keyword analysis and content repurposing. Timestamped view shows each segment with its timecode, useful for identifying when specific topics appear in the video." } },
    { "@type": "Question", "name": "Can I transcribe my own videos?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Paste the URL of any of your published YouTube videos. This is useful for auditing your own content: checking keyword usage, reviewing CTA placement, or extracting text for blog repurposing." } },
    { "@type": "Question", "name": "How long does transcription take?", "acceptedAnswer": { "@type": "Answer", "text": "Transcripts are extracted in seconds regardless of video length. The tool pulls existing caption data rather than processing audio." } },
    { "@type": "Question", "name": "Why does it say no transcript available for some videos?", "acceptedAnswer": { "@type": "Answer", "text": "Some video creators disable captions entirely, or the video may be too new for YouTube to have generated auto-captions. Live streams in progress also lack transcripts." } },
  ]
};

---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-white dark:bg-slate-950 pt-16 pb-12 sm:pt-20 sm:pb-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        <span class="inline-flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-3 py-1">3 free, no signup. Email for unlimited.</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-4">
        YouTube Transcript Generator
      </h1>
      <p class="text-gray-600 dark:text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        Paste a competitor's video. Get the clean transcript and a short brief on how it sells: hook, key claims, product mentions with timestamps, and the call to action.
      </p>
    </div>
  </section>

  <!-- Tool -->
  <section class="bg-white dark:bg-slate-950 pb-20">
    <div id="tool-container" class="max-w-xl mx-auto px-4">

      <!-- Step: Input -->
      <div id="step-input" class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-6 sm:p-8">
        <div class="mb-5">
          <p class="text-base font-semibold text-gray-900 dark:text-white mb-1">Get Started</p>
          <p class="text-sm text-gray-500 dark:text-slate-400">Paste a YouTube URL. Transcript in a few seconds, brief about ten seconds after.</p>
        </div>
        <div class="space-y-5">

          <div>
            <label for="url-input" class="block text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mb-2">
              YouTube video URL
            </label>
            <input
              type="url"
              id="url-input"
              placeholder="https://www.youtube.com/watch?v=..."
              class="w-full text-base font-medium px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500
                     focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-colors"
              aria-describedby="url-error"
            />
            <p id="url-error" class="hidden mt-1.5 text-xs text-rose-500 dark:text-rose-400" role="alert"></p>
            <p
              id="tool-notice"
              class="hidden mt-3 rounded-lg border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-200"
              role="status"
            ></p>
          </div>

        </div>

        <button
          id="generate-btn"
          class="mt-7 w-full inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-base font-bold
                 bg-emerald-500 text-white dark:text-slate-950 hover:bg-emerald-400 transition-colors"
        >
          Generate transcript &rarr;
        </button>

        <p id="counter-label" class="mt-3 text-center text-xs text-gray-400 dark:text-slate-600">
          3 free transcripts remaining
        </p>

        <!-- Recent videos: stored in this browser only, so a research session can hop between videos -->
        <div id="recent-videos" class="hidden mt-6 pt-5 border-t border-slate-200 dark:border-slate-700/60">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">Recent</p>
            <button id="recent-clear-btn" class="text-xs text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-white">Clear</button>
          </div>
          <ul id="recent-list" class="space-y-1.5"></ul>
        </div>
      </div>

      <!-- Step: Loading -->
      <div
        id="step-loading"
        class="hidden rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-6 sm:p-8 text-center"
      >
        <div class="flex flex-col items-center gap-4 py-10">
          <div class="w-10 h-10 border-[3px] border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
          <p class="text-sm font-medium text-gray-500 dark:text-slate-400">Extracting transcript... the brief follows in about ten seconds.</p>
          <p class="text-xs text-gray-400 dark:text-slate-600">This usually takes a few seconds</p>
        </div>
      </div>

      <!-- Step: Email Gate -->
      <div
        id="step-email-gate"
        class="hidden rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-6 sm:p-8"
      >
        <div class="text-center mb-6">
          <p class="text-base font-semibold text-gray-900 dark:text-white mb-2">You've used your 3 free transcripts</p>
          <p class="text-sm text-gray-500 dark:text-slate-400">
            Enter your business email to keep generating transcripts. It's free.
          </p>
        </div>
        <div id="gate-form" class="space-y-3">
          <input
            type="email"
            id="gate-email"
            placeholder="your@company.com"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500
                   focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 outline-none"
            aria-describedby="gate-email-error"
          />
          <p id="gate-email-error" class="hidden text-xs text-rose-500 dark:text-rose-400" role="alert"></p>
          <button
            id="gate-submit-btn"
            class="w-full inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-base font-bold
                   bg-emerald-500 text-white dark:text-slate-950 hover:bg-emerald-400 transition-colors"
          >
            Continue Generating
          </button>
          <p class="text-center text-xs text-gray-400 dark:text-slate-600">No spam. We'll only send you content marketing resources from SellonTube. Unsubscribe anytime.</p>
        </div>
        <div id="gate-success" class="hidden text-center mt-4">
          <p class="text-sm font-semibold text-emerald-500 dark:text-emerald-400">Done. Extracting your transcript now...</p>
        </div>
      </div>

    </div>

    <!-- Step: Results (wider) -->
    <div
      id="step-results"
      class="hidden max-w-3xl mx-auto px-4 mt-2"
      role="status"
      aria-live="polite"
    >
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 overflow-hidden">

        <!-- Header: what was transcribed -->
        <div class="p-6 sm:p-8 border-b border-slate-200 dark:border-slate-700/60">
          <div class="flex items-start gap-4">
            <a id="result-thumb-link" href="#" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 hidden sm:block">
              <img id="result-thumb" src="" alt="" width="120" height="68" loading="lazy" class="w-[120px] h-[68px] object-cover rounded-lg bg-slate-200 dark:bg-slate-800" />
            </a>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">Transcript for</p>
              <h2 id="result-title" tabindex="-1" class="text-base font-bold text-gray-900 dark:text-white leading-snug outline-none"></h2>
              <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">
                <span id="result-channel"></span>
                <span class="mx-1.5 text-slate-300 dark:text-slate-600">&middot;</span>
                <a id="result-video-link" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 hover:underline">Open on YouTube &nearr;</a>
              </p>
              <p id="result-stats" class="text-xs text-gray-400 dark:text-slate-500 mt-2 font-mono"></p>
              <p id="result-lang-note" class="hidden text-xs text-amber-700 dark:text-amber-400 mt-1"></p>
            </div>
          </div>
        </div>

        <!-- Tabs -->
        <div class="px-6 sm:px-8 border-b border-slate-200 dark:border-slate-700/60" role="tablist" aria-label="Transcript views">
          <div class="flex gap-6 -mb-px">
            <button id="tab-intel" role="tab" aria-selected="true" aria-controls="panel-intel" class="py-3 text-sm font-semibold border-b-2 border-emerald-500 text-emerald-600 dark:text-emerald-400 whitespace-nowrap">
              Intel<span id="tab-intel-state" class="ml-1.5 text-[11px] font-normal text-gray-400 dark:text-slate-500">building...</span>
            </button>
            <button id="tab-clean" role="tab" aria-selected="false" aria-controls="panel-transcript" class="py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap">Transcript</button>
            <button id="tab-timestamps" role="tab" aria-selected="false" aria-controls="panel-transcript" class="py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap">Timestamps</button>
          </div>
        </div>

        <!-- Panel: Intel (research brief; loads async, the transcript never waits for it) -->
        <div id="panel-intel" role="tabpanel" class="p-6 sm:p-8">
          <div class="flex items-center justify-between gap-3 mb-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">What this video is doing</p>
            <button id="copy-brief-btn" class="hidden text-xs border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-1 text-gray-500 dark:text-slate-400 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Copy brief</button>
          </div>

          <div id="brief-loading" class="space-y-2" aria-live="polite">
            <p class="text-sm text-gray-500 dark:text-slate-400">Reading the transcript for the hook, claims, structure, product mentions and CTA. About ten seconds. The Transcript tab is ready now.</p>
            <div class="h-3 w-3/4 rounded bg-slate-200 dark:bg-slate-800 animate-pulse"></div>
            <div class="h-3 w-full rounded bg-slate-200 dark:bg-slate-800 animate-pulse"></div>
            <div class="h-3 w-5/6 rounded bg-slate-200 dark:bg-slate-800 animate-pulse"></div>
          </div>

          <p id="brief-error" class="hidden text-sm text-gray-500 dark:text-slate-400"></p>

          <div id="brief-body" class="hidden space-y-5 text-sm text-gray-700 dark:text-slate-300 leading-relaxed">
            <p id="brief-oneliner" class="text-base font-semibold text-gray-900 dark:text-white"></p>
            <div>
              <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Hook (first 30 seconds)</p>
              <p id="brief-hook"></p>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Key claims</p>
              <ul id="brief-claims" class="list-disc pl-5 space-y-1"></ul>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Structure <span class="font-normal text-gray-400 dark:text-slate-500">(click a time to read that part)</span></p>
              <ul id="brief-structure" class="space-y-1"></ul>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Product and offer mentions</p>
              <ul id="brief-mentions" class="space-y-1.5"></ul>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Call to action</p>
                <p id="brief-cta"></p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">Who it is selling to</p>
                <p id="brief-buyer"></p>
              </div>
            </div>
            <p class="text-xs text-gray-400 dark:text-slate-500">AI-generated from the transcript. Check quotes against the video before you cite them.</p>
          </div>
        </div>

        <!-- Panel: Transcript / Timestamps (shared toolbar, two views) -->
        <div id="panel-transcript" role="tabpanel" class="hidden">
          <div class="px-6 sm:px-8 pt-5 flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <div class="relative flex-1 min-w-[12rem]">
                <input
                  type="search"
                  id="transcript-search"
                  placeholder="Search transcript (product name, keyword...)"
                  aria-label="Search transcript"
                  class="w-full text-sm px-3 py-2 pr-20 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 outline-none"
                />
                <span id="search-count" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-mono text-gray-400 dark:text-slate-500" aria-live="polite"></span>
              </div>
              <button id="search-next-btn" class="hidden text-xs font-semibold px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 text-gray-600 dark:text-slate-300 hover:border-emerald-500/50">Next &darr;</button>
              <button id="copy-full-btn" class="text-xs border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-gray-500 dark:text-slate-400 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Copy text</button>
              <button id="download-txt-btn" class="text-xs border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-gray-500 dark:text-slate-400 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Download .txt</button>
            </div>
            <!-- Top terms: the words this video leans on. Click one to search for it. -->
            <div id="top-terms" class="hidden flex-wrap items-center gap-1.5">
              <span class="text-[11px] font-semibold text-gray-400 dark:text-slate-500 mr-1">Top terms</span>
            </div>
          </div>

          <!-- Transcript body (collapsed until expanded; no nested scrollbar) -->
          <div class="relative">
            <div id="transcript-body" class="p-6 sm:p-8 max-h-[28rem] overflow-hidden">
              <div id="transcript-clean" class="space-y-4 text-sm text-gray-700 dark:text-slate-300 leading-relaxed"></div>
              <div id="transcript-timestamps" class="hidden space-y-3"></div>
            </div>
            <div id="transcript-fade" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-50 dark:from-slate-900 to-transparent pointer-events-none"></div>
          </div>
          <div id="expand-row" class="px-6 sm:px-8 pb-6">
            <button id="expand-btn" class="w-full py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-semibold text-gray-600 dark:text-slate-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" aria-expanded="false">
              Show full transcript
            </button>
          </div>
        </div>

        <!-- Reset -->
        <div class="px-6 pb-6 sm:px-8 sm:pb-8 pt-6">
          <button
            id="reset-btn"
            class="w-full py-3 rounded-xl border border-slate-300 dark:border-slate-700 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-white hover:border-slate-400 dark:hover:border-slate-500 transition-colors"
          >
            &larr; Generate another transcript
          </button>
        </div>

      </div>
    </div>
  </section>

  <CallToAction
    title="Transcripts are research. A strategy converts."
    subtitle="In our diagnostic, we map your full YouTube acquisition system: topics, CTAs, and the lead path from viewer to customer."
    actions={[
      {
        variant: 'primary',
        text: 'Book a diagnostic call',
        href: 'https://cal.com/gautham-8bdvdx/30min',
        target: '_blank',
        rel: 'noopener noreferrer',
      },
    ]}
  />

  <!-- How it works -->
  <section class="py-16 sm:py-20 bg-white dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 text-center mb-10">How it works</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
        <div>
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-bold mb-4">1</div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-2">Paste a YouTube URL</h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">Drop any public YouTube video URL into the input field. Works with any video that has captions enabled.</p>
        </div>
        <div>
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-bold mb-4">2</div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-2">Get a clean transcript</h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">The tool extracts the transcript and converts the YouTube video to clean, readable text. Toggle between clean text and timestamped view depending on your analysis needs.</p>
        </div>
        <div>
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-bold mb-4">3</div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-2">Copy and analyze</h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">Copy the full transcript with one click. Use it for competitor analysis, script research, keyword extraction, or content repurposing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="py-16 sm:py-20">
    <div class="max-w-2xl mx-auto px-4 space-y-16">

      <!-- Section 1 -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Why transcripts matter more than view counts for B2B YouTube strategy</h2>
        <p class="text-gray-600 dark:text-slate-400 leading-relaxed mb-4">
          A competitor's video has 50,000 views. You cannot replicate those views by watching the video. You can replicate the script structure, keyword usage, hook, CTA placement, and product positioning by reading the transcript.
        </p>
        <p class="text-gray-600 dark:text-slate-400 leading-relaxed mb-4">
          Transcripts turn competitor intelligence from "I watched their video" into "I know exactly how they structure their content, where they mention their product, what keywords they use in the first 30 seconds, and how they transition from education to pitch." That is actionable intelligence.
        </p>
        <p class="text-gray-600 dark:text-slate-400 leading-relaxed">
          For B2B marketers, the transcript is the script. Reverse-engineering a successful competitor's script is faster and more reliable than guessing at what works. This tool gives you that transcript in seconds. Once you have the intelligence, our <a href="/blog/youtube-marketing-strategy" class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">YouTube marketing strategy guide</a> shows how to turn it into a repeatable content system.
        </p>
      </div>

      <!-- Section 2: Workflow -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">How to use transcripts for competitive research</h2>
        <p class="text-gray-600 dark:text-slate-400 leading-relaxed mb-6">
          Extracting a transcript is step one. Here is how to turn it into competitive intelligence that improves your own content.
        </p>

        <div class="space-y-4">
          <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Analyze the first 30 seconds</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
              The hook determines whether a viewer stays. Read the first 3-4 sentences of the transcript. Does the competitor open with a problem statement, a question, a bold claim, or a story? Note what works and adapt the pattern for your own videos. The hook structure is the most replicable element.
            </p>
          </div>

          <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Find the product mention</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
