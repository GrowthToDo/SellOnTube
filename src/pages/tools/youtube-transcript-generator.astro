<script>
  // ===== CONSTANTS =====

  const RATE_LIMIT = 3;
  const COUNT_KEY = 'sot_transcript_count';
  const EMAIL_KEY = 'sot_transcript_email_submitted';
  const GATE_EMAIL_DOMAINS = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'aol.com', 'protonmail.com', 'mail.com', 'ymail.com', 'live.com'];
  const CAPTURE_URL = '/.netlify/functions/capture-email';

  // ===== STORAGE =====

  function getCount(): number { return parseInt(localStorage.getItem(COUNT_KEY) || '0', 10); }
  function incrementCount(): void { localStorage.setItem(COUNT_KEY, (getCount() + 1).toString()); }
  function isEmailSubmitted(): boolean { return localStorage.getItem(EMAIL_KEY) === 'true'; }
  function setEmailSubmitted(): void { localStorage.setItem(EMAIL_KEY, 'true'); }

  // ===== STATE =====

  type Segment = { text: string; start: number; duration: number };
  type Block = { start: number; text: string };

  let transcriptSegments: Segment[] = [];
  let paragraphs: Block[] = [];   // clean view: readable paragraphs
  let blocks: Block[] = [];       // timestamp view: ~30s chunks
  let currentVideoId = '';
  let currentTitle = '';
  let currentView: 'clean' | 'timestamps' = 'clean';
  type Tab = 'intel' | 'clean' | 'timestamps';
  let currentTab: Tab = 'intel';
  const RECENT_KEY = 'sot_transcript_recent';
  let searchQuery = '';
  let searchHits: HTMLElement[] = [];
  let searchIndex = -1;
  let briefText = '';
  let briefRequestId = 0;
  let wordCount = 0;

  // ===== STEP MANAGEMENT =====

  const STEPS = ['step-input', 'step-loading', 'step-email-gate', 'step-results'];
  function showStep(id: string): void {
    STEPS.forEach((s) => {
      const el = document.getElementById(s);
      if (el) el.classList.toggle('hidden', s !== id);
    });
    if (id === 'step-results') {
      // Now visible, so the fold can be measured for real.
      setCollapsed(true);
      const heading = document.getElementById('result-title');
      heading?.focus();
    }
  }

  // ===== COUNTER LABEL =====

  function updateCounterLabel(): void {
    const label = document.getElementById('counter-label');
    if (!label) return;
    if (isEmailSubmitted()) {
      label.textContent = 'Unlimited transcripts unlocked';
      return;
    }
    const remaining = Math.max(0, RATE_LIMIT - getCount());
    label.textContent = remaining === 1 ? '1 free transcript remaining' : remaining + ' free transcripts remaining';
  }

  // ===== VALIDATION =====

  function showFieldError(fieldId: string, message: string): void {
    const input = document.getElementById(fieldId) as HTMLInputElement | null;
    const error = document.getElementById(fieldId.replace('-input', '-error'));
    if (input) input.setAttribute('aria-invalid', 'true');
    if (error) { error.textContent = message; error.classList.remove('hidden'); }
  }

  function showToolNotice(message: string): void {
    const el = document.getElementById('tool-notice');
    if (el) { el.textContent = message; el.classList.remove('hidden'); }
  }

  function clearToolNotice(): void {
    const el = document.getElementById('tool-notice');
    if (el) { el.textContent = ''; el.classList.add('hidden'); }
  }

  function clearFieldError(fieldId: string): void {
    const input = document.getElementById(fieldId) as HTMLInputElement | null;
    const error = document.getElementById(fieldId.replace('-input', '-error'));
    if (input) input.removeAttribute('aria-invalid');
    if (error) { error.textContent = ''; error.classList.add('hidden'); }
  }

  function isValidYouTubeUrl(url: string): boolean {
    return /^(https?:\/\/)?(www\.)?(youtube\.com\/(watch\?v=|shorts\/|embed\/|v\/)|youtu\.be\/)[\w-]+/.test(url);
  }

  // ===== TIMESTAMP FORMATTING =====

  function formatTimestamp(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    if (h > 0) {
      return h + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
    return m + ':' + String(s).padStart(2, '0');
  }

  // ===== TABS =====

  const TAB_ACTIVE = ['border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400'];
  const TAB_INACTIVE = ['border-transparent', 'text-gray-500', 'dark:text-slate-400', 'hover:text-gray-900', 'dark:hover:text-white'];

  function setTab(tab: Tab): void {
    currentTab = tab;
    const buttons: Record<Tab, HTMLElement | null> = {
      intel: document.getElementById('tab-intel'),
      clean: document.getElementById('tab-clean'),
      timestamps: document.getElementById('tab-timestamps'),
    };
    (Object.keys(buttons) as Tab[]).forEach((key) => {
      const btn = buttons[key];
      if (!btn) return;
      const on = key === tab;
      btn.setAttribute('aria-selected', String(on));
      TAB_ACTIVE.forEach((c) => btn.classList.toggle(c, on));
      TAB_INACTIVE.forEach((c) => btn.classList.toggle(c, !on));
    });

    document.getElementById('panel-intel')?.classList.toggle('hidden', tab !== 'intel');
    document.getElementById('panel-transcript')?.classList.toggle('hidden', tab === 'intel');

    if (tab !== 'intel') {
      currentView = tab;
      document.getElementById('transcript-clean')?.classList.toggle('hidden', tab !== 'clean');
      document.getElementById('transcript-timestamps')?.classList.toggle('hidden', tab !== 'timestamps');
      const copyBtn = document.getElementById('copy-full-btn');
      if (copyBtn) copyBtn.textContent = tab === 'clean' ? 'Copy text' : 'Copy with timestamps';
      applySearch();
      // Panel was display:none while on Intel, so the fold could not be measured until now.
      setCollapsed(document.getElementById('transcript-body')?.classList.contains('max-h-[28rem]') ?? true);
    }
  }

  function setIntelTabState(state: 'loading' | 'ready' | 'error'): void {
    const el = document.getElementById('tab-intel-state');
    if (!el) return;
    el.textContent = state === 'loading' ? 'building...' : state === 'error' ? 'unavailable' : '';
    el.classList.toggle('hidden', state === 'ready');
  }

  // Scroll the Timestamps view to the block that contains `seconds` and flash it.
  function jumpToTranscriptTime(seconds: number): void {
    setTab('timestamps');
    setCollapsed(false);
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#transcript-timestamps [data-start]'));
    if (!rows.length) return;
    let target = rows[0];
    for (const row of rows) {
      if (Number(row.dataset.start) <= seconds + 0.5) target = row; else break;
    }
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    rows.forEach((r) => r.classList.remove('ring-2', 'ring-emerald-400', 'bg-emerald-500/5'));
    target.classList.add('ring-2', 'ring-emerald-400', 'bg-emerald-500/5');
    window.setTimeout(() => target.classList.remove('ring-2', 'ring-emerald-400', 'bg-emerald-500/5'), 2500);
  }

  // ===== TEXT SHAPING =====

  // YouTube captions use ">>" for a speaker change and hard line breaks inside a cue.
  function cleanCue(text: string): { text: string; speakerChange: boolean } {
    let t = text.replace(/\s+/g, ' ').trim();
    const speakerChange = /^(>>|&gt;&gt;)/.test(t);
    t = t.replace(/^(>>|&gt;&gt;)\s*/, '').replace(/\s*(>>|&gt;&gt;)\s*/g, '. ');
    return { text: t, speakerChange };
  }

  function endsSentence(t: string): boolean { return /[.!?]["')\]]?$/.test(t); }

  // Paragraphs: break on speaker change, a silence gap, or after ~75s once a sentence ends.
  // Blocks: same breaks, plus a new block after ~30s at a sentence end (60s hard cap), so every
  // half-minute or so gets a clickable timestamp without splitting mid-sentence.
  function shapeTranscript(segs: Segment[]): { paragraphs: Block[]; blocks: Block[] } {
    const paras: Block[] = [];
    const blks: Block[] = [];
    let p: Block | null = null;
    let b: Block | null = null;
    let prevEnd = 0;

    for (const seg of segs) {
      const { text, speakerChange } = cleanCue(seg.text);
      if (!text) continue;
      const gap = seg.start - prevEnd;
      const pElapsed = p ? seg.start - p.start : 0;
      const bElapsed = b ? seg.start - b.start : 0;
      const breakHere = !p || speakerChange || gap > 2.5 || (pElapsed > 75 && endsSentence(p.text)) || pElapsed > 150;

      if (breakHere || !p) { p = { start: seg.start, text }; paras.push(p); }
      else p.text += ' ' + text;

      const blockFull = bElapsed >= 60 || (bElapsed >= 30 && b !== null && endsSentence(b.text));
      if (!b || breakHere || blockFull) { b = { start: seg.start, text }; blks.push(b); }
      else b.text += ' ' + text;

      prevEnd = seg.start + seg.duration;
    }
    return { paragraphs: paras, blocks: blks };
  }

  function plainText(): string { return paragraphs.map((p) => p.text).join('\n\n'); }
  function timestampedText(): string { return blocks.map((b) => '[' + formatTimestamp(b.start) + '] ' + b.text).join('\n'); }
  function youtubeAt(seconds: number): string {
    return 'https://www.youtube.com/watch?v=' + currentVideoId + '&t=' + Math.floor(seconds) + 's';
  }

  function languageName(code: string | undefined): string {
    if (!code) return '';
    try {
      const dn = new (Intl as any).DisplayNames(['en'], { type: 'language' });
      return dn.of(code) || code;
    } catch { return code; }
  }

  // ===== RENDER RESULTS =====

  function renderTranscript(data: {
    videoId: string; title?: string; channel?: string; thumbnail?: string; lang?: string; segments: Segment[];
  }): void {
    transcriptSegments = data.segments;
    currentVideoId = data.videoId;
    currentTitle = data.title || data.videoId;
    ({ paragraphs, blocks } = shapeTranscript(transcriptSegments));

    // Header
    const titleEl = document.getElementById('result-title');
    if (titleEl) titleEl.textContent = currentTitle;
    const channelEl = document.getElementById('result-channel');
    if (channelEl) channelEl.textContent = data.channel || data.videoId;
    const videoUrl = 'https://www.youtube.com/watch?v=' + data.videoId;
    document.getElementById('result-video-link')?.setAttribute('href', videoUrl);
    document.getElementById('result-thumb-link')?.setAttribute('href', videoUrl);
    const thumb = document.getElementById('result-thumb') as HTMLImageElement | null;
    if (thumb) {
      thumb.src = data.thumbnail || 'https://i.ytimg.com/vi/' + data.videoId + '/hqdefault.jpg';
      thumb.alt = 'Thumbnail: ' + currentTitle;
    }

    // Stats
    const words = plainText().split(/\s+/).filter(Boolean).length;
    wordCount = words;
    const last = transcriptSegments[transcriptSegments.length - 1];
    const duration = last ? last.start + last.duration : 0;
    const wpm = duration > 0 ? Math.round(words / (duration / 60)) : 0;
    const statsEl = document.getElementById('result-stats');
    if (statsEl) {
      statsEl.textContent = [
        words.toLocaleString() + ' words',
        formatTimestamp(duration),
        wpm ? wpm + ' wpm' : '',
        languageName(data.lang),
      ].filter(Boolean).join('  \u00b7  ');
    }

    // Say so when the captions are not English, instead of silently showing another language.
    const langNote = document.getElementById('result-lang-note');
    if (langNote) {
      const isEnglish = !data.lang || data.lang.toLowerCase().startsWith('en');
      langNote.textContent = isEnglish ? '' : 'This video has no English captions. Showing the ' + languageName(data.lang) + ' transcript.';
      langNote.classList.toggle('hidden', isEnglish);
    }

    // The bottom "Next step" SEO card analyses this same video.
    document.getElementById('related-seo-card')?.setAttribute('href', '/tools/youtube-seo-tool?v=' + encodeURIComponent(videoUrl));

    loadBrief(data.videoId);

    const search = document.getElementById('transcript-search') as HTMLInputElement | null;
    if (search) search.value = '';
    searchQuery = '';
    renderViews();
    renderTopTerms();
    rememberRecent({ videoId: data.videoId, title: currentTitle, channel: data.channel || '' });
    setTab('intel');
    setCollapsed(true);
  }

  function escapeHtml(t: string): string {
    return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function highlight(text: string): string {
    const safe = escapeHtml(text);
    if (!searchQuery) return safe;
    const re = new RegExp('(' + searchQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return safe.replace(re, '<mark class="bg-amber-200 dark:bg-amber-400/40 text-inherit rounded px-0.5">$1</mark>');
  }

  function renderViews(): void {
    const cleanEl = document.getElementById('transcript-clean');
    if (cleanEl) cleanEl.innerHTML = paragraphs.map((p) => '<p>' + highlight(p.text) + '</p>').join('');

    const tsEl = document.getElementById('transcript-timestamps');
    if (tsEl) {
      tsEl.innerHTML = blocks.map((b) =>
        '<div class="flex items-start gap-3 rounded-lg px-1 -mx-1 transition-colors" data-start="' + b.start + '">' +
          '<a href="' + youtubeAt(b.start) + '" target="_blank" rel="noopener noreferrer" title="Open video at ' + formatTimestamp(b.start) + '" ' +
            'class="flex-shrink-0 text-xs font-mono text-emerald-600 dark:text-emerald-400 mt-0.5 w-14 text-right hover:underline">' + formatTimestamp(b.start) + '</a>' +
          '<p class="text-sm text-gray-700 dark:text-slate-300 leading-relaxed">' + highlight(b.text) + '</p>' +
        '</div>'
      ).join('');
    }
  }

  // ===== TOP TERMS =====

  const STOPWORDS = new Set(('a an the and or but if so as of at by for from in into on onto to with without about over under ' +
    'is are was were be been being am do does did doing have has had having will would shall should can could may might must ' +
    'i me my mine we us our you your yours he him his she her hers it its they them their this that these those there here ' +
    'what which who whom whose when where why how all any both each few more most other some such no nor not only own same ' +
    'than too very just really actually basically literally like kind sort thing things stuff way ways lot lots get got gets ' +
    'getting go goes going gone went come comes coming came make makes making made say says said saying see sees seen saw ' +
    'know knows knew known think thinks thought want wants wanted need needs needed take takes took taken give gives gave ' +
    'put let lets look looks looking looked use uses used using one two three first second next last new old good bad big ' +
    'little much many even still also again then now today ever never always often sometimes back up down out off over ' +
    'because while before after around through during between right okay ok yeah yes yep nope oh um uh hey hi guys people ' +
    'gonna wanna gotta because cause mean means meant well maybe pretty sure kinda thats its im ive youre theyre were dont ' +
    'doesnt didnt cant couldnt wont wouldnt isnt arent wasnt werent hasnt havent hadnt shouldnt video videos youtube channel ' +
    'something anything everything nothing someone anyone everyone nobody every super probably obviously definitely exactly ' +
    'able done did being those them time times day days year years month months week weeks ' +
    "don't doesn't didn't isn't aren't wasn't weren't can't couldn't won't wouldn't shouldn't hasn't haven't i'm i've you're they're we're that's it's there's here's what's let's watch watching watched").split(/\s+/));

  function renderTopTerms(): void {
    const row = document.getElementById('top-terms');
    if (!row) return;
    const counts = new Map<string, number>();
    for (const raw of plainText().toLowerCase().split(/[^a-z0-9$']+/)) {
      const w = raw.replace(/^'+|'+$/g, '').replace(/'s$/, '');
      if (w.length < 3 || STOPWORDS.has(w) || /^\d+$/.test(w)) continue;
      counts.set(w, (counts.get(w) || 0) + 1);
    }
    const top = Array.from(counts.entries()).filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).slice(0, 10);
    Array.from(row.querySelectorAll('button')).forEach((b) => b.remove());
    if (!top.length) { row.classList.add('hidden'); row.classList.remove('flex'); return; }
    for (const [word, n] of top) {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.term = word;
      b.className = 'text-[11px] font-medium px-2 py-0.5 rounded-full border border-slate-300 dark:border-slate-700 text-gray-600 dark:text-slate-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors';
      b.textContent = word + ' \u00d7' + n;
      row.appendChild(b);
    }
    row.classList.remove('hidden');
    row.classList.add('flex');
  }

  // ===== RECENT VIDEOS (this browser only) =====

  type RecentItem = { videoId: string; title: string; channel: string; at: number };

  function readRecent(): RecentItem[] {
    try {
      const list = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(list) ? list.filter((x) => x && typeof x.videoId === 'string') : [];
    } catch { return []; }
  }

  function rememberRecent(item: { videoId: string; title: string; channel: string }): void {
    try {
      const list = readRecent().filter((x) => x.videoId !== item.videoId);
      list.unshift({ ...item, at: Date.now() });
      localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, 5)));
    } catch { /* storage unavailable */ }
    renderRecent();
  }

  function renderRecent(): void {
    const wrap = document.getElementById('recent-videos');
    const ul = document.getElementById('recent-list');
    if (!wrap || !ul) return;
    const list = readRecent();
    ul.innerHTML = '';
    wrap.classList.toggle('hidden', list.length === 0);
    for (const item of list) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.videoId = item.videoId;
      b.className = 'w-full flex items-center gap-3 text-left rounded-lg px-2 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors';
      const img = document.createElement('img');
      img.src = 'https://i.ytimg.com/vi/' + item.videoId + '/default.jpg';
      img.alt = ''; img.width = 48; img.height = 27; img.loading = 'lazy';
      img.className = 'w-12 h-[27px] object-cover rounded flex-shrink-0 bg-slate-200 dark:bg-slate-800';
      const text = document.createElement('span');
      text.className = 'min-w-0 flex-1';
      const t = document.createElement('span');
      t.className = 'block text-sm text-gray-800 dark:text-slate-200 truncate';
      t.textContent = item.title || item.videoId;
      const c = document.createElement('span');
      c.className = 'block text-xs text-gray-400 dark:text-slate-500 truncate';
      c.textContent = item.channel || '';
      text.appendChild(t); text.appendChild(c);
      b.appendChild(img); b.appendChild(text);
      li.appendChild(b); ul.appendChild(li);
    }
  }

  // ===== COLLAPSE =====

  function setCollapsed(collapsed: boolean): void {
    const body = document.getElementById('transcript-body');
    const fade = document.getElementById('transcript-fade');
    const btn = document.getElementById('expand-btn');
    const row = document.getElementById('expand-row');
    body?.classList.toggle('max-h-[28rem]', collapsed);
    body?.classList.toggle('overflow-hidden', collapsed);
    // Short transcripts do not need a fold at all. While the card is still display:none the
    // measurements read 0, so assume it overflows and re-measure once shown (see showStep).
    const overflows = body ? body.clientHeight === 0 || body.scrollHeight > body.clientHeight + 8 : false;
    const needsFold = !collapsed || overflows;
    fade?.classList.toggle('hidden', !(collapsed && overflows));
    row?.classList.toggle('hidden', !needsFold);
    if (btn) {
      btn.textContent = collapsed
        ? 'Show full transcript' + (wordCount ? ' (' + wordCount.toLocaleString() + ' words)' : '')
        : 'Collapse transcript';
      btn.setAttribute('aria-expanded', String(!collapsed));
    }
  }

  // ===== SEARCH =====

  function applySearch(): void {
    renderViews();
    const container = document.getElementById(currentView === 'clean' ? 'transcript-clean' : 'transcript-timestamps');
    searchHits = container ? Array.from(container.querySelectorAll('mark')) as HTMLElement[] : [];
    searchIndex = -1;
    const count = document.getElementById('search-count');
    const next = document.getElementById('search-next-btn');
    if (count) count.textContent = searchQuery ? (searchHits.length + (searchHits.length === 1 ? ' match' : ' matches')) : '';
    next?.classList.toggle('hidden', searchHits.length < 2);
    if (searchQuery && searchHits.length) { setCollapsed(false); jumpToHit(0); }
  }

  function jumpToHit(i: number): void {
    if (!searchHits.length) return;
    searchHits.forEach((m) => m.classList.remove('ring-2', 'ring-amber-500'));
    searchIndex = (i + searchHits.length) % searchHits.length;
    const hit = searchHits[searchIndex];
    hit.classList.add('ring-2', 'ring-amber-500');
    hit.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const count = document.getElementById('search-count');
    if (count) count.textContent = (searchIndex + 1) + ' / ' + searchHits.length;
  }

  // ===== COPY / DOWNLOAD =====

  function copyText(text: string, btnEl: HTMLElement): void {
    navigator.clipboard.writeText(text).then(() => {
      const original = btnEl.textContent;
      btnEl.textContent = 'Copied!';
      btnEl.classList.add('text-emerald-400', 'border-emerald-500/50');
      setTimeout(() => {
        btnEl.textContent = original;
        btnEl.classList.remove('text-emerald-400', 'border-emerald-500/50');
      }, 1500);
    });
  }

  function safeFilename(): string {
    return (currentTitle || currentVideoId).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || currentVideoId;
  }

  function downloadFile(name: string, content: string, mime: string): void {
    const blob = new Blob([content], { type: mime + ';charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  // ===== RESEARCH BRIEF =====

  type Brief = {
    oneLiner: string; hook: string; keyClaims: string[];
    structure: Array<{ timestamp: string; label: string }>;
    productMentions: Array<{ timestamp: string; text: string }>; cta: string; targetBuyer: string;
  };

  function timestampRow(timestamp: string, text: string): HTMLLIElement {
    const seconds = timestampToSeconds(timestamp);
    const li = document.createElement('li');
    li.className = 'flex items-start gap-2';
    const jump = document.createElement('button');
    jump.type = 'button';
    jump.title = 'Read this part of the transcript';
    jump.className = 'flex-shrink-0 text-xs font-mono text-emerald-600 dark:text-emerald-400 mt-0.5 w-12 text-right hover:underline';
    jump.textContent = timestamp;
    jump.addEventListener('click', () => jumpToTranscriptTime(seconds));
    const yt = document.createElement('a');
    yt.href = youtubeAt(seconds);
    yt.target = '_blank'; yt.rel = 'noopener noreferrer';
    yt.title = 'Open the video at ' + timestamp;
    yt.setAttribute('aria-label', 'Open the video at ' + timestamp);
    yt.className = 'flex-shrink-0 text-[10px] text-gray-400 dark:text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 mt-1';
    yt.textContent = '\u25b6';
    const p = document.createElement('p'); p.textContent = text;
    li.appendChild(jump); li.appendChild(yt); li.appendChild(p);
    return li;
  }

  function setText(id: string, text: string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function timestampToSeconds(ts: string): number {
    const parts = ts.split(':').map((n) => parseInt(n, 10));
    if (parts.some((n) => isNaN(n))) return 0;
    return parts.reduce((acc, n) => acc * 60 + n, 0);
  }

  function renderBrief(b: Brief): void {
    setText('brief-oneliner', b.oneLiner);
    setText('brief-hook', b.hook || 'Not identified.');
    setText('brief-cta', b.cta || 'None found.');
    setText('brief-buyer', b.targetBuyer || 'Not identified.');

    const claims = document.getElementById('brief-claims');
    if (claims) {
      claims.innerHTML = '';
      for (const c of b.keyClaims) { const li = document.createElement('li'); li.textContent = c; claims.appendChild(li); }
      if (!b.keyClaims.length) { const li = document.createElement('li'); li.textContent = 'No specific claims found.'; claims.appendChild(li); }
    }

    const structure = document.getElementById('brief-structure');
    if (structure) {
      structure.innerHTML = '';
      const sections = Array.isArray(b.structure) ? b.structure : [];
      for (const sec of sections) structure.appendChild(timestampRow(sec.timestamp, sec.label));
      if (!sections.length) { const li = document.createElement('li'); li.textContent = 'Not identified.'; structure.appendChild(li); }
    }

    const mentions = document.getElementById('brief-mentions');
    if (mentions) {
      mentions.innerHTML = '';
      for (const m of b.productMentions) mentions.appendChild(timestampRow(m.timestamp, m.text));
      if (!b.productMentions.length) { const li = document.createElement('li'); li.textContent = 'No product or offer is mentioned.'; mentions.appendChild(li); }
    }

    briefText = [
      b.oneLiner, '',
      'Hook: ' + b.hook, '',
      'Key claims:', ...b.keyClaims.map((c) => '- ' + c), '',
      'Structure:', ...((b.structure || []).length ? b.structure.map((x) => '- [' + x.timestamp + '] ' + x.label) : ['- Not identified']), '',
      'Product and offer mentions:', ...(b.productMentions.length ? b.productMentions.map((m) => '- [' + m.timestamp + '] ' + m.text) : ['- None']), '',
      'Call to action: ' + (b.cta || 'None found.'),
      'Selling to: ' + (b.targetBuyer || 'Not identified.'),
    ].join('\n');

    document.getElementById('brief-loading')?.classList.add('hidden');
    document.getElementById('brief-error')?.classList.add('hidden');
    document.getElementById('brief-body')?.classList.remove('hidden');
    document.getElementById('copy-brief-btn')?.classList.remove('hidden');
    setIntelTabState('ready');
  }

  function showBriefError(message: string): void {
    document.getElementById('brief-loading')?.classList.add('hidden');
    document.getElementById('brief-body')?.classList.add('hidden');
    document.getElementById('copy-brief-btn')?.classList.add('hidden');
    const el = document.getElementById('brief-error');
    if (el) { el.textContent = message; el.classList.remove('hidden'); }
    setIntelTabState('error');
  }

  async function loadBrief(videoId: string): Promise<void> {
    const requestId = ++briefRequestId;
    briefText = '';
    document.getElementById('brief-body')?.classList.add('hidden');
    document.getElementById('brief-error')?.classList.add('hidden');
    document.getElementById('copy-brief-btn')?.classList.add('hidden');
    document.getElementById('brief-loading')?.classList.remove('hidden');
    setIntelTabState('loading');

    try {
      const res = await fetch('/api/summarize-transcript', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ videoId }),
      });
      if (requestId !== briefRequestId) return; // user moved on to another video
      if (res.status === 429) { showBriefError('The summary service is at capacity right now. The transcript above is complete.'); return; }
      if (!res.ok) { showBriefError('Could not build the brief for this video. The transcript above is complete.'); return; }
      const data = await res.json();
      if (!data?.brief) { showBriefError('Could not build the brief for this video.'); return; }
      renderBrief(data.brief as Brief);
      window.dataLayer = window.dataLayer || [];
      window.gtag('event', 'transcript_brief_shown', { tool: 'transcript-generator', cached: !!data.cached });
    } catch {
      if (requestId !== briefRequestId) return;
      showBriefError('Could not build the brief for this video. The transcript above is complete.');
    }
  }

  // ===== API CALL =====

  async function fetchTranscript(url: string): Promise<void> {
    const btn = document.getElementById('generate-btn') as HTMLButtonElement;

    try {
      const res = await fetch('/api/get-transcript', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });

      if (res.status === 429) {
        showStep('step-input');
        btn.disabled = false;
        btn.textContent = 'Generate transcript \u2192';
        showFieldError('url-input', 'Service is at capacity. Please try again in a moment.');
        window.dataLayer = window.dataLayer || [];
        window.gtag('event', 'tool_generate_error', { tool: 'transcript-generator', reason: 'quota_exceeded' });
        return;
      }

      // 503 = an upstream service is down, not a problem with the user's URL.
      // Shown as a page notice rather than a field error so we do not blame their input.
      if (res.status === 503) {
        showStep('step-input');
        btn.disabled = false;
        btn.textContent = 'Generate transcript →';
        showToolNotice(
          'The transcript service is temporarily unavailable. Nothing is wrong with your link. Please try again later.'
        );
        window.dataLayer = window.dataLayer || [];
        window.gtag('event', 'tool_generate_error', { tool: 'transcript-generator', reason: 'upstream_unavailable' });
        return;
      }

      // 422 = the service worked, but this particular video has no captions. That is about
      // the video, so it belongs under the URL field, unlike the 503 outage notice above.
      if (res.status === 422) {
        const body = await res.json().catch(() => ({}));
        showStep('step-input');
        btn.disabled = false;
        btn.textContent = 'Generate transcript →';
        showFieldError('url-input', body.error || 'This video has no captions available.');
        window.dataLayer = window.dataLayer || [];
        window.gtag('event', 'tool_generate_error', { tool: 'transcript-generator', reason: 'no_captions' });
        return;
      }

      if (!res.ok) {
        throw new Error('Something went wrong on our end. Please try again in a moment.');
      }

      // /api/get-transcript returns { videoId, segments: [{ text, start, duration }] }
      // with start and duration already in seconds. See netlify/functions/lib/transcript.ts.
      const data = await res.json();
      const segments: Segment[] = Array.isArray(data.segments) ? data.segments : [];

      if (segments.length === 0) {
        throw new Error('No transcript found. The video may not have captions available.');
      }

      renderTranscript({ ...data, segments });
      // Shareable / bookmarkable URL for this result.
      try { history.replaceState(null, '', '?v=' + encodeURIComponent(data.videoId || url)); } catch { /* ignore */ }
      incrementCount();
      updateCounterLabel();
      showStep('step-results');
      document.getElementById('step-results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      window.dataLayer = window.dataLayer || [];
      window.gtag('event', 'tool_generate_success', { tool: 'transcript-generator' });

    } catch (err) {
      showStep('step-input');
      btn.disabled = false;
      btn.textContent = 'Generate transcript \u2192';
      const message = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      showFieldError('url-input', message);
      window.dataLayer = window.dataLayer || [];
      window.gtag('event', 'tool_generate_error', { tool: 'transcript-generator', reason: 'api_error' });
    }
  }

  // ===== GENERATE =====

  async function generate(): Promise<void> {
    const urlInput = document.getElementById('url-input') as HTMLInputElement;
    const url = urlInput.value.trim();

    if (!url) {
      showFieldError('url-input', 'Please enter a YouTube URL.');
      return;
    }

    if (!isValidYouTubeUrl(url)) {
      showFieldError('url-input', 'Please enter a valid YouTube URL (e.g. https://www.youtube.com/watch?v=...)');
      return;
    }

    clearFieldError('url-input');
    clearToolNotice();

    // Email gate check
    if (getCount() >= RATE_LIMIT && !isEmailSubmitted()) {
      window.dataLayer = window.dataLayer || [];
      window.gtag('event', 'tool_email_gate_shown', { tool: 'transcript-generator' });
      showStep('step-email-gate');
      return;
    }

    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'tool_generate_click', { tool: 'transcript-generator' });

    const btn = document.getElementById('generate-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Extracting...';
    showStep('step-loading');

    await fetchTranscript(url);
  }

  // ===== EMAIL GATE =====

  async function submitGateEmail(): Promise<void> {
    const emailInput = document.getElementById('gate-email') as HTMLInputElement;
    const email = emailInput.value.trim().toLowerCase();
    const errorEl = document.getElementById('gate-email-error');

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      if (errorEl) { errorEl.textContent = 'Please enter a valid business email address.'; errorEl.classList.remove('hidden'); }
      return;
    }

    const domain = email.split('@')[1];
    if (GATE_EMAIL_DOMAINS.includes(domain)) {
      if (errorEl) { errorEl.textContent = 'Please use a business email address (not Gmail, Yahoo, etc.)'; errorEl.classList.remove('hidden'); }
      return;
    }

    if (errorEl) errorEl.classList.add('hidden');

    const btn = document.getElementById('gate-submit-btn') as HTMLButtonElement;
    btn.textContent = 'Submitting...';
    btn.setAttribute('disabled', 'true');

    try {
      await fetch(CAPTURE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'youtube-transcript-generator' }),
      });
    } catch { /* silent */ }

    setEmailSubmitted();
    updateCounterLabel();

    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'tool_email_submitted', { tool: 'transcript-generator' });

    const form = document.getElementById('gate-form') as HTMLElement;
    const success = document.getElementById('gate-success') as HTMLElement;
    form.classList.add('hidden');
    success.classList.remove('hidden');

    setTimeout(() => {
      form.classList.remove('hidden');
      success.classList.add('hidden');
      btn.textContent = 'Continue Generating';
      btn.removeAttribute('disabled');
      emailInput.value = '';
      generate();
    }, 1200);
  }

  // ===== RESET =====

  function reset(): void {
    (document.getElementById('url-input') as HTMLInputElement).value = '';
    clearFieldError('url-input');
    clearToolNotice();
    showStep('step-input');
    (document.getElementById('url-input') as HTMLInputElement).focus();
    const btn = document.getElementById('generate-btn') as HTMLButtonElement;
    btn.disabled = false;
    btn.textContent = 'Generate transcript \u2192';
  }

  // ===== EVENT LISTENERS =====

  document.getElementById('generate-btn')?.addEventListener('click', generate);
  document.getElementById('reset-btn')?.addEventListener('click', reset);
  document.getElementById('gate-submit-btn')?.addEventListener('click', submitGateEmail);
  document.getElementById('tab-intel')?.addEventListener('click', () => setTab('intel'));
  document.getElementById('tab-clean')?.addEventListener('click', () => setTab('clean'));
  document.getElementById('tab-timestamps')?.addEventListener('click', () => setTab('timestamps'));

  document.getElementById('top-terms')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-term]') as HTMLElement | null;
    if (!btn) return;
    const input = document.getElementById('transcript-search') as HTMLInputElement | null;
    if (input) input.value = btn.dataset.term || '';
    searchQuery = btn.dataset.term || '';
    applySearch();
    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'transcript_term_click', { tool: 'transcript-generator' });
  });

  document.getElementById('recent-list')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-video-id]') as HTMLElement | null;
    if (!btn) return;
    const input = document.getElementById('url-input') as HTMLInputElement | null;
    if (input) input.value = 'https://www.youtube.com/watch?v=' + btn.dataset.videoId;
    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'transcript_recent_click', { tool: 'transcript-generator' });
    generate();
  });
  document.getElementById('recent-clear-btn')?.addEventListener('click', () => {
    try { localStorage.removeItem(RECENT_KEY); } catch { /* ignore */ }
    renderRecent();
  });

  document.getElementById('copy-full-btn')?.addEventListener('click', function () {
    copyText(currentView === 'clean' ? plainText() : timestampedText(), this as HTMLElement);
    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'transcript_copied', { tool: 'transcript-generator', view: currentView });
  });

  document.getElementById('download-txt-btn')?.addEventListener('click', () => {
    const header = currentTitle + '\nhttps://www.youtube.com/watch?v=' + currentVideoId + '\n\n';
    downloadFile(safeFilename() + '.txt', header + (currentView === 'clean' ? plainText() : timestampedText()), 'text/plain');
    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'transcript_downloaded', { tool: 'transcript-generator', format: 'txt' });
  });

  document.getElementById('copy-brief-btn')?.addEventListener('click', function () {
    if (briefText) copyText(briefText, this as HTMLElement);
    window.dataLayer = window.dataLayer || [];
    window.gtag('event', 'transcript_brief_copied', { tool: 'transcript-generator' });
  });

  document.getElementById('expand-btn')?.addEventListener('click', () => {
    const body = document.getElementById('transcript-body');
    setCollapsed(!body?.classList.contains('max-h-[28rem]'));
  });

  let searchTimer: number | undefined;
  document.getElementById('transcript-search')?.addEventListener('input', (e) => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applySearch();
    }, 150);
  });
  document.getElementById('transcript-search')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); jumpToHit(searchIndex + 1); }
  });
  document.getElementById('search-next-btn')?.addEventListener('click', () => jumpToHit(searchIndex + 1));

  // Prefill from ?v= (used by other tools' "for this video" links and shared result URLs).
  const prefill = new URLSearchParams(window.location.search).get('v');
  if (prefill) {
    const input = document.getElementById('url-input') as HTMLInputElement | null;
    if (input) {
      input.value = /^[\w-]{11}$/.test(prefill) ? 'https://www.youtube.com/watch?v=' + prefill : prefill;
      generate();
    }
  }

  // Enter key submits
  document.getElementById('url-input')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') {
      e.preventDefault();
      generate();
    }
  });

  document.getElementById('gate-email')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') submitGateEmail();
  });

  updateCounterLabel();
  renderRecent();
</script>
