---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import heroPhoto from '~/assets/images/dental/hero.jpg';
import scanPhoto from '~/assets/images/dental/scan.jpg';
import frontDeskPhoto from '~/assets/images/dental/front-desk-call.jpg';
import consultPhoto from '~/assets/images/dental/consult.jpg';
import Layout from '~/layouts/PageLayout.astro';
import AiSeoTheme from '~/components/ai-seo/AiSeoTheme.astro';
import AiSeoHeader from '~/components/ai-seo/AiSeoHeader.astro';
import AiSeoFooter from '~/components/ai-seo/AiSeoFooter.astro';
import AiSeoTracking from '~/components/ai-seo/AiSeoTracking.astro';
import DentalReportCard from '~/components/ai-seo/DentalReportCard.astro';
import DentalSystem from '~/components/ai-seo/DentalSystem.astro';
import DentalSearchPanels from '~/components/ai-seo/DentalSearchPanels.astro';
import { AI_SEO_CAL_LINK, caseStudyPath, featuredCaseStudy } from '~/data/ai-seo';
import { DENTAL_CTA, DENTAL_CTA_NOTE, DENTAL_INDEXABLE, DENTAL_PATH, dental } from '~/data/ai-seo-dental';

/** Numbered section tags for owner review. Set to false before shipping. */
const REVIEW_TAGS = false;
const tag = (n: number) => (REVIEW_TAGS ? String(n) : undefined);

const metadata = {
  title: dental.title,
  description: dental.description,
  robots: { index: DENTAL_INDEXABLE, follow: true },
  openGraph: {
    images: [{ url: '~/assets/images/og/ai-seo-dental.jpg', width: 1200, height: 630 }],
  },
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Dental patient acquisition',
  serviceType: 'Dental practice marketing: local SEO, Google Business Profile, Google Ads, treatment pages, AI search',
  description: dental.description,
  url: `${SITE.site}${DENTAL_PATH}`,
  areaServed: { '@type': 'Country', name: 'United States' },
  provider: { '@type': 'Organization', name: 'SellOnTube', url: SITE.site },
  audience: { '@type': 'BusinessAudience', name: 'Independent dental practices and small dental groups' },
};

const caseHref = featuredCaseStudy ? caseStudyPath(featuredCaseStudy.slug) : undefined;
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <AiSeoHeader
      base={DENTAL_PATH}
      servicesId="services"
      checkId="faq"
      checkLabel="FAQ"
      label="SellOnTube dental patient acquisition"
      showCase={false}
      subline={dental.headerSubline}
    />
  </Fragment>
  <Fragment slot="footer">
    <AiSeoFooter
      servicesHref={`${DENTAL_PATH}#services`}
      showCase={false}
      label="Dental patient acquisition footer"
      callLabel="Book a call"
      homeHref={DENTAL_PATH}
    />
  </Fragment>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  />
  <AiSeoTheme />
  <AiSeoTracking />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="ais dl">
    <div id="ais-main">
      <!-- 1. Hero: copy left, sample report right. Phone: copy, CTA, report. -->
      <section class="dl-hero" data-dental-hero data-review={tag(1)}>
        <div class="ais-wrap dl-hero__grid">
          <div class="dl-hero__copy">
            <p class="dl-eyebrow">{dental.hero.eyebrow}</p>
            <h1 class="dl-h1">{dental.hero.headline}</h1>
            <p class="dl-lede">{dental.hero.subhead}</p>
            <div class="dl-cta">
              <a class="ais-btn dl-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="dental-hero"
                >{DENTAL_CTA}</a
              >
              <p class="dl-cta__note">{DENTAL_CTA_NOTE}</p>
            </div>
            <ul class="dl-checks dl-hero__trust">
              {dental.hero.trust.map((item) => <li>{item}</li>)}
            </ul>
            <p class="dl-qualifier"><strong>Founding program:</strong> {dental.hero.qualifier.replace('Founding program: ', '')}</p>
          </div>
          <div class="dl-hero__media">
            <Image
              class="dl-hero__photo"
              src={heroPhoto}
              alt={dental.photos.hero.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1040px) 34rem, calc(100vw - 2.5rem)"
              loading="eager"
              fetchpriority="high"
            />
            <div class="dl-chip" aria-label="Sample month, made-up numbers">
              <span class="dl-chip__label">{dental.heroChip.label}</span>
              <strong>{dental.heroChip.booked}</strong>
              <span>{dental.heroChip.detail}</span>
              <small>{dental.heroChip.note}</small>
            </div>
          </div>
        </div>
      </section>

      <!-- 1b. Sample report band -->
      <section class="dl-report-band" aria-labelledby="report-title" data-review={REVIEW_TAGS ? '1b' : undefined}>
        <div class="ais-wrap dl-report-band__grid">
          <div>
            <h2 class="dl-h2" id="report-title">{dental.reportBand.title}</h2>
            <p class="dl-lede">{dental.reportBand.text}</p>
          </div>
          <DentalReportCard
            title={dental.report.title}
            subtitle={dental.report.subtitle}
            sampleNote={dental.report.sampleNote}
            columns={dental.report.columns}
            rows={dental.report.rows}
            noSpendLabel={dental.report.noSpendLabel}
            footnote={dental.report.footnote}
            alt={dental.report.alt}
          />
        </div>
      </section>

      <!-- 2. Trust strip -->
      <div class="dl-strip" data-review={tag(2)}>
        <ul class="ais-wrap dl-strip__list">
          {dental.trustStrip.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- 3. Problem -->
      <section class="dl-section" aria-labelledby="problem-title" data-review={tag(3)}>
        <div class="ais-wrap">
          <div class="dl-photo-head">
            <h2 class="dl-h2 dl-h2--wide" id="problem-title">{dental.problem.title}</h2>
            <Image
              class="dl-photo"
              src={scanPhoto}
              alt={dental.photos.scan.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 960px) 26rem, calc(100vw - 2.5rem)"
              loading="lazy"
            />
          </div>
          <ol class="dl-problems">
            {
              dental.problem.items.map((item, i) => (
                <li>
                  <span class="dl-problems__n" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="dl-h3">{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 4. The system -->
      <section class="dl-section dl-section--wash" id="how" aria-labelledby="system-title" data-review={tag(4)}>
        <div class="ais-wrap">
          <div class="dl-split-head">
            <h2 class="dl-h2" id="system-title">{dental.system.title}</h2>
            <p class="dl-lede">{dental.system.lede}</p>
          </div>
          <DentalSystem steps={dental.system.steps} label="How the patient acquisition system works" />
          <div class="dl-cta dl-cta--row">
            <a class="ais-btn dl-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="dental-system"
              >{DENTAL_CTA}</a
            >
            <p class="dl-cta__note">{DENTAL_CTA_NOTE}</p>
          </div>
        </div>
      </section>

      <!-- 5. AI search -->
      <section class="dl-section" aria-labelledby="ai-title" data-review={tag(5)}>
        <div class="ais-wrap">
          <div class="dl-split-head">
            <h2 class="dl-h2" id="ai-title">{dental.aiSearch.title}</h2>
            <div>
              <p class="dl-lede">{dental.aiSearch.text}</p>
              <p class="dl-honest">{dental.aiSearch.honest}</p>
            </div>
          </div>
          <DentalSearchPanels query={dental.aiSearch.query} panelNote={dental.aiSearch.panelNote} />
          {
            caseHref && (
              <aside class="dl-proof" aria-label="Proof from outside dental">
                <span class="dl-proof__label">{dental.aiSearch.proof.label}</span>
                <p>{dental.aiSearch.proof.text}</p>
                <a href={caseHref} data-ais-case="dental">
                  {dental.aiSearch.proof.cta} <span aria-hidden="true">&rarr;</span>
                </a>
              </aside>
            )
          }
        </div>
      </section>

      <!-- 6. Services -->
      <section class="dl-section dl-section--wash" id="services" aria-labelledby="services-title" data-review={tag(6)}>
        <div class="ais-wrap">
          <h2 class="dl-h2" id="services-title">{dental.services.title}</h2>
          <div class="dl-services">
            {
              dental.services.groups.map((group) => (
                <div class="dl-services__group">
                  <p class="dl-services__name">{group.name}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li>
                        <h3 class="dl-h3">{item.title}</h3>
                        <p>{item.text}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="dl-cta dl-cta--row">
            <a class="ais-btn dl-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="dental-services"
              >{DENTAL_CTA}</a
            >
            <p class="dl-cta__note">{DENTAL_CTA_NOTE}</p>
          </div>
        </div>
      </section>

      <!-- 7. How you will know it works -->
      <section class="dl-section" aria-labelledby="measure-title" data-review={tag(7)}>
        <div class="ais-wrap">
          <div class="dl-split-head">
            <h2 class="dl-h2" id="measure-title">{dental.measure.title}</h2>
            <p class="dl-lede">{dental.measure.lede}</p>
          </div>
          <div class="dl-vs">
            <div class="dl-vs__old">
              <h3 class="dl-vs__title">{dental.measure.oldTitle}</h3>
              <ul>{dental.measure.old.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="dl-vs__new">
              <h3 class="dl-vs__title">{dental.measure.newTitle}</h3>
              <ul>{dental.measure.new.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
          <div class="dl-rules-row">
            <div class="dl-rules">
              <h3 class="dl-h3">{dental.measure.rulesTitle}</h3>
              <ol>{dental.measure.rules.map((rule) => <li>{rule}</li>)}</ol>
              <p class="dl-note">{dental.measure.note}</p>
            </div>
            <Image
              class="dl-photo"
              src={frontDeskPhoto}
              alt={dental.photos.frontDesk.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 960px) 24rem, calc(100vw - 2.5rem)"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- 8. Who we work with -->
      <section class="dl-section dl-section--wash" aria-labelledby="audience-title" data-review={tag(8)}>
        <div class="ais-wrap">
          <h2 class="dl-h2" id="audience-title">{dental.audience.title}</h2>
          <div class="dl-audience">
            <Image
              class="dl-photo dl-audience__photo"
              src={consultPhoto}
              alt={dental.photos.consult.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 960px) 24rem, calc(100vw - 2.5rem)"
              loading="lazy"
            />
            {
              dental.audience.segments.map((segment, i) => (
                <div class:list={['dl-audience__seg', { 'is-main': i === 0 }]}>
                  <h3 class="dl-h3">{segment.title}</h3>
                  <p>{segment.text}</p>
                </div>
              ))
            }
          </div>
          <div class="dl-fit">
            <div>
              <h3 class="dl-fit__title">{dental.audience.fitTitle}</h3>
              <ul class="dl-checks">{dental.audience.fit.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div>
              <h3 class="dl-fit__title">{dental.audience.notFitTitle}</h3>
              <ul class="dl-crosses">{dental.audience.notFit.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 9. Founding program -->
      <section class="dl-section" aria-labelledby="pilot-title" data-review={tag(9)}>
        <div class="ais-wrap">
          <div class="dl-split-head">
            <h2 class="dl-h2" id="pilot-title">{dental.pilot.title}</h2>
            <p class="dl-lede">{dental.pilot.text}</p>
          </div>
          <ol class="dl-timeline" aria-label="The first 90 days">
            {
              dental.pilot.steps.map((step, i) => (
                <li>
                  <span class="dl-timeline__node" aria-hidden="true">
                    {i + 1}
                  </span>
                  <strong>{step.label}</strong>
                  <span>{step.text}</span>
                </li>
              ))
            }
          </ol>
          <div class="dl-cta dl-cta--row">
            <a class="ais-btn dl-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="dental-pilot"
              >{DENTAL_CTA}</a
            >
            <p class="dl-cta__note">{DENTAL_CTA_NOTE}</p>
          </div>
        </div>
      </section>

      <!-- 10. Privacy -->
      <section class="dl-section dl-section--wash dl-section--tight" aria-labelledby="privacy-title" data-review={tag(10)}>
        <div class="ais-wrap">
          <div class="dl-split-head">
            <h2 class="dl-h2 dl-h2--sm" id="privacy-title">{dental.privacy.title}</h2>
            <p class="dl-lede">{dental.privacy.text}</p>
          </div>
          <ul class="dl-privacy">
            {
              dental.privacy.points.map((point) => (
                <li>
                  <strong>{point.title}</strong>
                  <span>{point.text}</span>
                </li>
              ))
            }
          </ul>
          <p class="dl-note">{dental.privacy.note}</p>
        </div>
      </section>

      <!-- 11. FAQ -->
      <section class="dl-section" id="faq" aria-labelledby="faq-title" data-review={tag(11)}>
        <div class="ais-wrap">
          <h2 class="dl-h2" id="faq-title">Questions practices ask before the call</h2>
          <div class="dl-faq">
            {
              dental.faqs.map((faq) => (
                <div class="dl-faq__item">
                  <h3 class="dl-h3">{faq.q}</h3>
                  <p>{faq.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 12. Final CTA -->
      <section class="dl-section dl-section--tight" aria-labelledby="closing-title" data-review={tag(12)}>
        <div class="ais-wrap">
          <div class="dl-close">
            <div>
              <h2 class="dl-h2" id="closing-title">{dental.closing.title}</h2>
              <p class="dl-lede">{dental.closing.text}</p>
            </div>
            <div class="dl-cta">
              <a class="ais-btn dl-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="dental-closing"
                >{DENTAL_CTA}</a
              >
              <p class="dl-cta__note">{DENTAL_CTA_NOTE}</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- No bottom sticky bar: the sticky header already keeps "Book a call" on screen. -->
  </div>
</Layout>

<style is:global>
  /* Page-only palette (owner decision 2026-11-17): navy and sky blue on white.
     This stylesheet ships only with this route, so other AI SEO pages keep their palette.
     The doubled class beats the base `.ais` rule in AiSeoTheme. */
  .ais.ais {
    --paper: #ffffff;
    --tint: #eef2f7;
    --white: #ffffff;
    --wash: #f7f9fc;
    --ink: #0e2a47;
    --ink-2: #3a4f66;
    --ink-3: #5a6b7e;
    --rule: #e1e7ef;
    --accent: #2f6fb0;
    --accent-ink: #245a91;
    --accent-bright: #5b9bd5;
    --sky-tint: #e8f1fa;
    --on-accent: #ffffff;
    --band: #0e2a47;
    --on-band: #ffffff;
    --on-band-2: #c9d6e6;
    --off-cell: #3a4f66;
    --display: 'Plus Jakarta Sans', 'Inter Variable', system-ui, sans-serif;
    --body: 'Plus Jakarta Sans', 'Inter Variable', system-ui, sans-serif;
    --shadow-card: 0 1px 2px rgba(14, 42, 71, 0.06), 0 16px 40px rgba(14, 42, 71, 0.1);
  }
  .ais-header.ais {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(8px);
  }
  .ais-header.ais .ais-btn {
    border-color: var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
  }

  /* Review tags: numbered badges so the owner can refer to sections by number. */
  [data-review] {
    position: relative;
  }
  [data-review]::before {
    content: '\00a7' attr(data-review);
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 5;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: #f59e0b;
    color: #1f1300;
    font: 700 0.8125rem/1.4 system-ui, sans-serif;
  }
</style>

<style>
  .dl {
    background: var(--paper);
    color: var(--ink-2);
    font-family: var(--body);
  }

  /* Type */
  .dl-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--white);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .dl-eyebrow::before {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--accent-bright);
  }
  .dl-h1 {
    margin: 0;
    max-width: 16ch;
    color: var(--ink);
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5.2vw, 3.625rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .dl-h2 {
    margin: 0 0 1rem;
    max-width: 22ch;
    color: var(--ink);
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .dl-h2--wide {
    max-width: 30ch;
  }
  .dl-h2--sm {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .dl-h3 {
    margin: 0 0 0.375rem;
    color: var(--ink);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .dl-lede {
    margin: 0;
    max-width: 38rem;
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .dl-note {
    margin: 1rem 0 0;
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .dl p {
    text-wrap: pretty;
  }

  /* Buttons and CTA blocks */
  .dl :global(.dl-btn) {
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
    font-weight: 700;
  }
  .dl :global(.dl-btn:hover) {
    border-color: var(--accent-ink);
    background: var(--accent-ink);
  }
  .dl-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 2rem;
  }
  .dl-cta--row {
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .dl-cta--row {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }
  .dl-cta__note {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  /* Check and cross lists */
  .dl-checks,
  .dl-crosses {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dl-checks li,
  .dl-crosses li {
    position: relative;
    padding: 0.3125rem 0 0.3125rem 1.75rem;
    line-height: 1.5;
  }
  .dl-checks li::before,
  .dl-crosses li::before {
    position: absolute;
    left: 0;
    top: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    font-size: 0.6875rem;
    font-weight: 800;
  }
  .dl-checks li::before {
    content: '\2713';
    background: var(--sky-tint);
    color: var(--accent);
  }
  .dl-crosses li::before {
    content: '\2715';
    background: var(--tint);
    color: var(--ink-3);
  }

  /* Sections */
  .dl-section {
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }
  .dl-section--tight {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .dl-section--wash {
    background: var(--wash);
    border-block: 1px solid var(--rule);
  }
  .dl-split-head {
    display: grid;
    gap: 1rem 4rem;
    margin-bottom: 2.75rem;
  }
  @media (min-width: 960px) {
    .dl-split-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
    .dl-split-head .dl-h2 {
      margin: 0;
    }
  }
  .dl-honest {
    margin: 1rem 0 0;
    padding-left: 0.875rem;
    border-left: 3px solid var(--accent-bright);
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* 1. Hero */
  .dl-hero {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--sky-tint), transparent 70%),
      var(--paper);
  }
  .dl-hero__grid {
    display: grid;
    gap: 2.75rem;
  }
  @media (min-width: 1040px) {
