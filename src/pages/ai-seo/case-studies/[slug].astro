---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import Layout from '~/layouts/PageLayout.astro';
import AiSeoTheme from '~/components/ai-seo/AiSeoTheme.astro';
import AiSeoHeader from '~/components/ai-seo/AiSeoHeader.astro';
import AiSeoFooter from '~/components/ai-seo/AiSeoFooter.astro';
import AiSeoTracking from '~/components/ai-seo/AiSeoTracking.astro';
import AnswerCard from '~/components/ai-seo/AnswerCard.astro';
import ClientLogo from '~/components/ai-seo/ClientLogo.astro';
import ProofGrid from '~/components/ai-seo/ProofGrid.astro';
import QuestionMap from '~/components/ai-seo/QuestionMap.astro';
import RangePlot from '~/components/ai-seo/RangePlot.astro';
import SourceBars from '~/components/ai-seo/SourceBars.astro';
import labelPhoto from '~/assets/images/case-studies/label-wizard-label.jpg';
import fullShot from '~/assets/images/case-studies/label-wizard-chatgpt-full.png';
import { authors } from '~/data/authors';
import {
  AI_SEO_CAL_LINK,
  AI_SEO_PATH,
  caseStudyPath,
  landing,
  publishedCaseStudies,
  type CaseStudy,
} from '~/data/ai-seo';

export function getStaticPaths() {
  return publishedCaseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

export interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const author = authors.Sathyanand;

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const metadata = {
  title: study.title,
  ignoreTitleTemplate: true,
  description: study.description,
  openGraph: {
    type: 'article',
    images: [{ url: '~/assets/images/og/ai-seo-label-wizard.jpg', width: 1200, height: 630 }],
  },
};

const landingUrl = `${SITE.site}${AI_SEO_PATH}`;
const pageUrl = `${SITE.site}${caseStudyPath(study.slug)}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: study.headline,
    description: study.description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    datePublished: study.publishDate,
    dateModified: study.publishDate,
    author: { '@type': 'Person', name: author.name, url: author.linkedin },
    publisher: { '@type': 'Organization', name: 'SellOnTube', url: SITE.site },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
      { '@type': 'ListItem', position: 2, name: 'AI SEO Services', item: landingUrl },
      { '@type': 'ListItem', position: 3, name: `${study.client} Case Study`, item: pageUrl },
    ],
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header"><AiSeoHeader /></Fragment>
  <Fragment slot="footer"><AiSeoFooter /></Fragment>

  <AiSeoTheme />
  <AiSeoTracking />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="ais">
    <article id="ais-main">
      <header class="ais-hero ais-band">
        <div class="ais-wrap">
          <p class="ais-crumbs"><a href={AI_SEO_PATH}>AI SEO services</a> / {study.client} case study</p>
          <ClientLogo client={study.client} />
          <p class="ais-eyebrow">{study.clientLine}</p>
          <h1 class="ais-h1 ais-h1--study">{study.headline}</h1>
          <div class="ais-prose ais-hero__opening">{study.opening.map((p) => <p>{p}</p>)}</div>

          <dl class="ais-strip">
            <div>
              <dd>{study.stats.installEvents}<span class="ais-strip__of">/{study.stats.sessions}</span></dd>
              <dt>Install events from ChatGPT sessions</dt>
            </div>
            <div>
              <dd>{study.stats.rate}</dd>
              <dt>ChatGPT install rate</dt>
            </div>
          </dl>
          <p class="ais-note">{study.period}, GA4.</p>

          <div class="ais-actions">
            <a
              class="ais-btn"
              href={AI_SEO_CAL_LINK}
              target="_blank"
              rel="noopener noreferrer"
              data-ais-cta="case-study-top">Book a discovery call</a
            >
            <a class="ais-btn ais-btn--band-ghost" href={`${AI_SEO_PATH}#check`} data-ais-cta="case-study-check-top">
              Get a free ChatGPT check
            </a>
          </div>

          <div class="ais-byline">
            <Image src={author.photo} alt={author.photoAlt} width={96} height={96} loading="lazy" />
            <p>
              By <a href={author.linkedin}>{author.name}</a>. Published {formatDate(study.publishDate)}. Data through {
                formatDate(study.dataThrough)
              }.
            </p>
          </div>
        </div>
      </header>

      <section class="ais-section ais-section--white" aria-labelledby="answers-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="answers-title">What Did ChatGPT Say About {study.client}?</h2>
          <p class="ais-lede">{study.answersIntro}</p>
          <figure class="ais-evidence">
            <a href={fullShot.src} target="_blank" rel="noopener noreferrer">
              <Image
                src={fullShot}
                alt="ChatGPT screenshot. Asked Is there an app where I can set my own label size, it says yes, offers three options, and lists 1. Label Wizard by Left Foot Software, tagged Custom sizes supported"
                widths={[480, 800, fullShot.width]}
                sizes="(min-width: 1000px) 56rem, 100vw"
                loading="lazy"
              />
            </a>
            <figcaption class="ais-note">{study.screenshotNote} Tap to enlarge.</figcaption>
          </figure>
          <p class="ais-records-intro">{study.recordsIntro}</p>
          <div class="ais-answers" role="region" aria-label="Recorded ChatGPT answers" tabindex="0">
            {study.answers.map((answer) => <AnswerCard answer={answer} />)}
          </div>
          <p class="ais-note ais-answers__note">{study.answerNote}</p>
          <QuestionMap tracked={study.questions.tracked} named={study.questions.named} client={study.client} />
        </div>
      </section>

      <section class="ais-section" aria-labelledby="results-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="results-title">What Came In?</h2>
          <div class="ais-proof">
            <ProofGrid
              sessions={study.stats.sessions}
              installEvents={study.stats.installEvents}
              rate={study.stats.rate}
              note={study.sourceNote}
            />
            <div>
              <div class="ais-prose">{study.cameIn.first.map((p) => <p>{p}</p>)}</div>
              <RangePlot
                low={study.interval.low}
                high={study.interval.high}
                point={study.interval.point}
                note={study.cameIn.rangeNote}
              />
            </div>
          </div>
          <div class="ais-proof ais-sub">
            <div class="ais-prose">{study.cameIn.comparison.map((p) => <p>{p}</p>)}</div>
            <SourceBars rates={study.sourceRates} note={study.sourceRatesNote} />
          </div>
        </div>
      </section>

      <section class="ais-section ais-section--tint" aria-labelledby="limits-title">
        <div class="ais-wrap">
          <p class="ais-eyebrow">But there's a catch</p>
          <h2 class="ais-h2" id="limits-title">What Can't I Claim?</h2>
          <div class="ais-two">
            <div>
              <h3 class="ais-h3">What This Data Can't Show</h3>
              <ul class="ais-list">{study.cantProve.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div>
              <h3 class="ais-h3">What Didn't Go Well</h3>
              <ul class="ais-list">{study.didntGoWell.map((item) => <li>{item}</li>)}</ul>
              <p class="ais-limits-close">{study.limitsClose}</p>
            </div>
          </div>
          <div class="ais-prompt">
            <p>{landing.caseClosing.prompt}</p>
            <a class="ais-btn" href={`${AI_SEO_PATH}#check`} data-ais-cta="case-study-check-mid">
              Get a free ChatGPT check
            </a>
          </div>
        </div>
      </section>

      <section class="ais-section ais-section--white" aria-labelledby="work-title">
        <div class="ais-wrap ais-two">
          <div>
            <h2 class="ais-h2" id="work-title">What Did My Team Do?</h2>
            <div class="ais-prose">{study.work.map((p) => <p>{p}</p>)}</div>
            <figure class="ais-shot">
              <Image
                src={labelPhoto}
                alt="Label Wizard listing image of a candle jar label with logo, price, barcode and QR code"
                widths={[480, 800, 900]}
                sizes="(min-width: 768px) 34rem, 100vw"
                loading="lazy"
              />
              <figcaption class="ais-note">Cropped from an image on the {study.client} App Store listing.</figcaption>
            </figure>
          </div>
          <div>
            <h3 class="ais-h3">How It Unfolded in 2026</h3>
            <ol class="ais-rail">
              {
                study.timeline.map((item) => (
                  <li class:list={{ 'is-on': item.highlight }}>
                    <strong>{item.when}</strong>
                    <span>{item.text}</span>
                  </li>
                ))
              }
            </ol>
            <p class="ais-note">{study.timelineNote}</p>
          </div>
        </div>
      </section>

      <section class="ais-band ais-section" aria-labelledby="closing-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="closing-title">{landing.caseClosing.title}</h2>
          <div class="ais-prose">{landing.caseClosing.text.map((p) => <p>{p}</p>)}</div>
          <div class="ais-actions">
            <a class="ais-btn" href={`${AI_SEO_PATH}#check`} data-ais-cta="case-study-check">
              Get a free ChatGPT check
            </a>
            <a
              class="ais-btn ais-btn--band-ghost"
              href={AI_SEO_CAL_LINK}
              target="_blank"
              rel="noopener noreferrer"
              data-ais-cta="case-study">Book a discovery call</a
            >
          </div>
        </div>
      </section>

      <section class="ais-section ais-section--method" aria-label="Method">
        <div class="ais-wrap">
          <details class="ais-details">
            <summary>How I calculated these numbers</summary>
            <ul class="ais-list">{study.method.map((item) => <li>{item}</li>)}</ul>
          </details>
        </div>
      </section>
    </article>
  </div>
</Layout>
