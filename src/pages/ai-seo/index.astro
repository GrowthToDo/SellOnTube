---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import Layout from '~/layouts/PageLayout.astro';
import AiSeoTheme from '~/components/ai-seo/AiSeoTheme.astro';
import AiSeoHeader from '~/components/ai-seo/AiSeoHeader.astro';
import AiSeoFooter from '~/components/ai-seo/AiSeoFooter.astro';
import AiSeoTracking from '~/components/ai-seo/AiSeoTracking.astro';
import AiSeoFlow from '~/components/ai-seo/AiSeoFlow.astro';
import AnswerCard from '~/components/ai-seo/AnswerCard.astro';
import AnswerCheckForm from '~/components/ai-seo/AnswerCheckForm.astro';
import SessionUnits from '~/components/ai-seo/SessionUnits.astro';
import foundersPhoto from '~/assets/images/team/founders-group.jpg';
import { AI_SEO_CAL_LINK, AI_SEO_PATH, caseStudyPath, featuredCaseStudy as study, landing } from '~/data/ai-seo';

const description = study ? landing.descriptionWithProof : landing.descriptionPlain;

const metadata = {
  title: landing.title,
  description,
  openGraph: {
    images: [{ url: '~/assets/images/og/ai-seo.jpg', width: 1200, height: 630 }],
  },
};

const pageUrl = `${SITE.site}${AI_SEO_PATH}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI SEO Services',
  serviceType: 'AI SEO',
  description: landing.descriptionPlain,
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'SellOnTube', url: SITE.site },
  audience: { '@type': 'BusinessAudience', name: 'B2B companies' },
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header"><AiSeoHeader /></Fragment>
  <Fragment slot="footer"><AiSeoFooter /></Fragment>

  <AiSeoTheme />
  <AiSeoTracking />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="ais">
    <div id="ais-main">
      <section class="ais-hero">
        <div class:list={['ais-wrap', { 'ais-hero__grid': study }]}>
          <div>
            <p class="ais-eyebrow">{landing.eyebrow}</p>
            <h1 class="ais-h1">{landing.headline}</h1>
            <p class="ais-lede" style="margin-top: 1.5rem">{landing.stakes}</p>
            <p class="ais-subhead">{landing.subhead}</p>
            <div class="ais-actions">
              <a class="ais-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="hero">
                Book a discovery call
              </a>
              <a class="ais-btn ais-btn--ghost" href="#check" data-ais-cta="hero-check"
                >See what ChatGPT says about you, free</a
              >
            </div>
          </div>
          {
            study && (
              <div>
                <AnswerCard answer={study.answers[0]} />
                <p class="ais-note" style="margin-top: 0.75rem">
                  A real answer about our client {study.client}. Answers vary, and nobody can guarantee a
                  recommendation.
                </p>
              </div>
            )
          }
        </div>
      </section>

      {
        study && (
          <section class="ais-section" aria-labelledby="proof-title">
            <div class="ais-wrap ais-proof">
              <div>
                <p class="ais-proof__client">{study.clientLine}</p>
                <h2 class="ais-proof__line" id="proof-title">
                  22 Install Events From 65 ChatGPT Sessions ({study.stats.rate})
                </h2>
                <p class="ais-proof__numbers">
                  {study.stats.installEvents}
                  <span class="ais-proof__of">/{study.stats.sessions}</span>
                </p>
                <p class="ais-note">{study.sourceNote}</p>
                <p style="margin-top: 1rem">
                  <a class="ais-link" href={caseStudyPath(study.slug)} data-ais-case="proof">
                    Read the {study.client} case study
                  </a>
                </p>
              </div>
              <SessionUnits sessions={study.stats.sessions} installEvents={study.stats.installEvents} />
            </div>
          </section>
        )
      }

      <section class="ais-section" aria-labelledby="what-title">
        <div class="ais-wrap">
          {study && <p class="ais-bridge">{landing.bridges.what}</p>}
          <h2 class="ais-h2" id="what-title">What Is AI SEO?</h2>
          <div class="ais-prose"><p>{landing.answer}</p></div>
          <AiSeoFlow />
        </div>
      </section>

      <section class="ais-section" id="services" aria-labelledby="services-title">
        <div class="ais-wrap">
          <p class="ais-bridge">{landing.bridges.services}</p>
          <h2 class="ais-h2" id="services-title">What Do Our AI SEO Services Include?</h2>
          <p class="ais-lede">{landing.methodLine}</p>
          <ol class="ais-rows">
            {
              landing.services.map((service, i) => (
                <li>
                  <span class="ais-rows__n" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="ais-h3">{service.title}</h3>
                  <p>{service.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="ais-optional">{landing.optionalLine}</p>

          <div class="ais-topics">
            <div>
              <h3 class="ais-h3">How We Choose Topics</h3>
              <p style="margin: 0; color: var(--ink-2)">{landing.topicTests}</p>
            </div>
            <div>
              <ul class="ais-questions">
                {landing.illustrativeQuestions.map((question) => <li>{question}</li>)}
              </ul>
              <p class="ais-note" style="margin: 0">{landing.illustrativeNote}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="ais-band ais-section" id="check" aria-labelledby="check-title">
        <div class="ais-wrap ais-two">
          <div>
            <p class="ais-bridge">{landing.bridges.check}</p>
            <h2 class="ais-h2" id="check-title">{landing.check.title}</h2>
            <p class="ais-lede" style="color: inherit">{landing.check.text}</p>
          </div>
          <AnswerCheckForm />
        </div>
      </section>

      <section class="ais-section" aria-labelledby="steps-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="steps-title">What Happens After You Say Yes?</h2>
          <ol class="ais-rows">
            {
              landing.steps.map((step, i) => (
                <li>
                  <span class="ais-rows__n" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="ais-h3">{step.title}</h3>
                  <p>{step.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="ais-section" aria-labelledby="measure-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="measure-title">How Do We Measure Success?</h2>
          <p class="ais-lede">We count leads and customers first, and AI visibility second.</p>
          <div class="ais-table-wrap" role="region" aria-label="How we measure success" tabindex="0">
            <table class="ais-table">
              <thead>
                <tr>
                  <th scope="col">Level</th>
                  <th scope="col">What we look at</th>
                </tr>
              </thead>
              <tbody>
                {
                  landing.measures.map((measure) => (
                    <tr>
                      <th scope="row">{measure.level}</th>
                      <td>{measure.items}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="ais-note" style="margin-top: 1rem">{landing.measureNote}</p>
        </div>
      </section>

      <section class="ais-section" aria-labelledby="team-title">
        <div class="ais-wrap ais-team">
          <Image
            src={foundersPhoto}
            alt="SellOnTube founders Gautham, Sathyanand and Pradeep Pandey standing together outdoors"
            widths={[480, 800, 1120]}
            sizes="(min-width: 900px) 34rem, 100vw"
            loading="lazy"
          />
          <div>
            <p class="ais-bridge">{landing.bridges.team}</p>
            <h2 class="ais-h2" id="team-title">{landing.team.title}</h2>
            <div class="ais-prose">{landing.team.text.map((p) => <p>{p}</p>)}</div>
            <h3 class="ais-h3" style="margin-top: 2rem">Who Is This For?</h3>
            <p style="margin: 0; color: var(--ink-2); max-width: 42rem">{landing.fit}</p>
          </div>
        </div>
      </section>

      <section class="ais-section" aria-labelledby="faq-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="faq-title">FAQ</h2>
          <div class="ais-faq">
            {
              landing.faqs.map((faq) => (
                <div class="ais-faq__item">
                  <h3 class="ais-h3">{faq.q}</h3>
                  <p>{faq.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="ais-band ais-section" aria-labelledby="closing-title">
        <div class="ais-wrap">
          <h2 class="ais-h2" id="closing-title">{landing.closing.title}</h2>
          <p class="ais-lede" style="color: inherit">{landing.closing.text}</p>
          <div class="ais-actions">
            <a class="ais-btn" href={AI_SEO_CAL_LINK} target="_blank" rel="noopener noreferrer" data-ais-cta="closing">
              Book a discovery call
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
