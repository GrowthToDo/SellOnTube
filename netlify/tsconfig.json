{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // lib/*.js are plain ESM modules (package.json sets "type": "module") so `node --test`
    // can run them on every Node in the CI matrix. allowJs lets the .ts functions import them.
    "allowJs": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "~/*": ["../src/*"]
    }
  },
  "include": ["functions/**/*"],
  "exclude": ["dist/", "functions/**/*.test.js"]
}
